---
import { Code } from "astro:components"
import sobernetics from "../assets/sobernetics.svg?raw"
import CodeBlock from "../components/CodeBlock.astro"
import Logo from "../components/Logo.astro"
import { FAVICON } from "../icon"
import { NAVIGATION } from "../navigation"
import { datastarLangs, hangingIndent, shikiThemes } from "../shiki"
import "../styles/global.css"

// Written the way it would be written, not the way a phone would like it. A narrow screen
// wraps the long line with a hanging indent (see hangingIndent in src/shiki.ts), and this
// block is a poster on every screen wide enough to hold it, which is most of them.
// The one section of the list the hero has just made a promise about, so the eye should find
// it without being shouted at. Named here rather than in the markup, because it is a choice.
const FEATURED = "The tooling"

const SAMPLE = `get("/feed") {
    call.respondDatastar {
        patchElements(selector = "#feed", mode = ElementPatchMode.APPEND) {
            li { +"A new head hangs on the wall" }
        }
        patchSignals("heads" to 13)
    }
}`
---

<!doctype html>
<!--
  The landing page is dark, always, whatever the reader or their system has chosen. It is one
  page and it is a poster: the mark, the neon and the deep ground were drawn for each other,
  and a light variant of them is a different poster. Every other page follows the reader.

  The consequence is honest and worth naming: someone who prefers light gets dark here and
  light from the next click onward. The masthead on those pages keeps the same dark band, so
  the top of the screen at least stays continuous.
-->
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Streamlord: a Datastar toolchain for Kotlin</title>
    <meta
      name="description"
      content="Datastar lives in strings your compiler never reads. Streamlord checks them in your editor, when the event is built, and before a byte reaches the browser, with adapters for Ktor and Spring."
    />
    <link rel="canonical" href={Astro.site} />
    <link rel="icon" href={FAVICON} type="image/svg+xml" />
  </head>
  <body>
    <a class="fs-skip-link" href="#content">Skip to content</a>

    <!--
      Neon needs somewhere dark to be neon, and a muted variant for a light theme would lose
      the colour exactly where it is doing the work.

      The band is deeper than the page's own dark surface because that is the ground the mark
      was drawn on. Everything else reads its colours from the tokens.
    -->
    <header class="hero">
      <div class="hero__inner">
        <Logo size={72} />
        <h1 class="hero__word">Streamlord</h1>
        <p class="hero__line">A Datastar toolchain for Kotlin.</p>
        <p class="hero__sub">
          Datastar lives in strings your compiler never reads. Streamlord checks them anyway:
          in your editor as you type, when the event is built, and before a byte reaches the
          browser. Ktor and Spring included.
        </p>

        <div class="hero__sample">
          <Code
            code={SAMPLE}
            lang="kotlin"
            themes={shikiThemes}
            langs={datastarLangs}
            transformers={[hangingIndent]}
          />
        </div>

        <!--
          The reader here has chosen Datastar and is choosing a library for it, so the row
          reads as the journey they are actually on: proof that this one works, then the
          reason to take it over the official SDK, then the way in. Install is a need you
          have after deciding, and it is one screen down in the list below.
        -->
        <div class="hero__actions">
          <!-- Linked only now that the service it talks to exists outside this machine. -->
          <a class="fs-button" href="/live/">See it run</a>
          <a class="fs-button" data-variant="secondary" href="/editors/">The editors</a>
          <a class="fs-button" data-variant="ghost" href="/first-stream/">Your first stream</a>
        </div>

        <!--
          The creed the README opens with, which the site itself had nowhere to put. It belongs
          on the poster and not on a reference page: the last two lines are the whole argument
          for Datastar, and they make it faster than the paragraph above ever could.
        -->
        <figure class="creed">
          <blockquote class="creed__words">
            <p>The elders of Bonereach asked Gorvek what a warrior wants of a stream.</p>
            <p>
              "That it flows when I say flow. That it stops when I say stop. That it carries
              my will to the far shore, and nothing else."
            </p>
            <p>"And the JavaScript?"</p>
            <p>"I do not know the word."</p>
          </blockquote>
          <figcaption class="creed__who">
            Gorvek of Bonereach, who walked out of the Ashfall with iron in his hand
          </figcaption>
        </figure>
      </div>
    </header>

    <main class="page" id="content">
      {
        NAVIGATION.map((section) => (
          <section class="section" data-featured={section.title === FEATURED ? "" : undefined}>
            <h2 class="fs-heading" data-size="s">{section.title}</h2>
            <ul class="fs-list" data-variant="plain">
              {section.pages.map((page) => (
                <li>
                  <a class="fs-link" href={`/${page.slug}/`}>
                    {page.title}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </main>

    <footer class="colophon">
      <a class="sobernetics" href="https://sobernetics.no"><Fragment set:html={sobernetics} /></a>
    </footer>

    <CodeBlock />

    <style>
      /* The foot of the page: a rule and real room above it, so the mark reads as a signature
         under the content rather than as another line of it. */
      .colophon {
        max-width: 60rem;
        margin: var(--fs-spacing-16) auto var(--fs-spacing-10);
        padding: var(--fs-spacing-5) var(--fs-spacing-6) 0;
        border-top: 1px solid var(--fs-color-neutral-border-subtle);
      }

            /* The Søbernetics mark. Small on purpose, and small is the whole of how it stays quiet: the
         opacity this first had took it to 3.5:1 against the ground, which is below the contrast
         required of a link, and on one page left it all but invisible. Subtlety is size, not a
         washed-out colour.

         The red is Søbernetics' own, set here per theme rather than taken from the host's accent
         token. Streamlord's accent is a blue, so the mark arrived there wearing Streamlord's colour,
         and a mark that changes hue per project is not a mark. */
      .sobernetics {
        --sobernetics-accent: #c8102e;
        display: inline-block;
        color: var(--fs-color-neutral-text-subtle);
      }

      @media (prefers-color-scheme: dark) {
        :root:not([data-theme="light"]) .sobernetics { --sobernetics-accent: #f44851; }
      }

      :root[data-theme="dark"] .sobernetics { --sobernetics-accent: #f44851; }

      .sobernetics:hover,
      .sobernetics:focus-visible {
        color: var(--fs-color-neutral-text-strong);
      }

      /* `:global` because the mark arrives through `set:html`. Astro stamps its scope id on
         elements it can see in the template, and an injected child is not one of them, so a
         plain descendant selector here reaches nothing and the drawing collapses to no height
         at all. This is the one rule that has to cross the scope. */
      .sobernetics :global(svg) {
        display: block;
        height: 18px;
        width: auto;
      }

      .hero {
        /* Deeper than the page's own dark surface: this is the ground the mark was drawn on. */
        background: #0c0d14;
        color: var(--fs-color-neutral-text-strong);
        border-block-end: 1px solid rgba(0, 177, 250, 0.25);
      }
      .hero__inner {
        max-width: 60rem;
        margin: 0 auto;
        padding: var(--fs-spacing-12) var(--fs-spacing-5) var(--fs-spacing-10);
        display: grid;
        justify-items: start;
        gap: var(--fs-spacing-4);
      }
      .hero__word {
        margin: 0;
        /* The floor is a phone: at 2.5rem the word alone measured 330px of a 390px screen. */
        font-size: clamp(2rem, 9vw, 4.5rem);
        line-height: 1;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        /* Flat, so the logo beside it is the only gradient on the screen. */
        color: var(--fs-color-accent-fill);
      }
      .hero__line {
        margin: 0;
        font-size: var(--font-size-l);
        color: var(--fs-color-neutral-text-strong);
      }
      .hero__sub {
        margin: 0;
        max-width: 46ch;
        color: var(--fs-color-neutral-text-subtle);
        line-height: var(--fs-line-height-article);
      }
      .hero__sample {
        inline-size: 100%;
        margin-block-start: var(--fs-spacing-3);
        /*
         * A grid item may not shrink below its content by default, and `pre` does not wrap,
         * so this one measured 666px inside a 390px phone. The column grew to fit it, the
         * document became 686px wide, and `.hero`, which is only as wide as the viewport,
         * covered a little over half of it: the dark ground ended mid-screen and the rest of
         * the page showed through beside it. `overflow-x: auto` on the block never engaged,
         * because nothing was ever too narrow for it.
         *
         * Zero minimum, and the column can be as narrow as the phone. Then the code scrolls
         * inside its own box, which is what it was always meant to do.
         */
        min-inline-size: 0;
      }
      .hero__sample :global(pre) {
        margin: 0;
        padding: var(--fs-spacing-4);
        border-radius: var(--fs-spacing-1);
        border: 1px solid rgba(0, 177, 250, 0.2);
        overflow-x: auto;
        /*
         * Down a step on a phone and no further: below about 11px a monospace font stops
         * being read and starts being decoded. The sample is written narrow enough that this
         * is the whole of it. The scroll below is a safety net, not the plan.
         */
        font-size: clamp(0.7rem, 2.9vw, var(--font-size-s));
      }
      .hero__sample :global(code) {
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      }
      /* The same hanging indent the articles use, for a screen narrower than this sample. */
      .hero__sample :global(pre code) {
        white-space: normal;
      }
      .hero__sample :global(pre .line) {
        display: block;
        white-space: pre;
        min-block-size: 1lh;
      }
      @media (max-width: 40rem) {
        .hero__sample :global(pre .line) {
          white-space: pre-wrap;
          overflow-wrap: break-word;
          padding-inline-start: calc(var(--indent, 0) * 1ch + 2ch);
          text-indent: calc((var(--indent, 0) * 1ch + 2ch) * -1);
        }
      }

      .hero__actions {
        display: flex;
        flex-wrap: wrap;
        gap: var(--fs-spacing-3);
        margin-block-start: var(--fs-spacing-2);
      }

      /* Quiet, and set off by the same neon the border above uses, at a quarter strength. */
      .creed {
        margin: var(--fs-spacing-6) 0 0;
        max-width: 46ch;
        padding-inline-start: var(--fs-spacing-4);
        border-inline-start: 2px solid rgba(0, 177, 250, 0.35);
        color: var(--fs-color-neutral-text-subtle);
      }
      .creed__words {
        margin: 0;
        font-style: italic;
        line-height: var(--fs-line-height-article);
      }
      .creed__words p {
        margin: 0 0 var(--fs-spacing-2);
      }
      .creed__words p:last-child {
        margin-block-end: 0;
      }
      .creed__who {
        margin: var(--fs-spacing-3) 0 0;
        font-size: var(--font-size-s);
        font-style: normal;
      }

      /*
       * Multi-column, not a grid: the sections are lists of very different lengths, and a
       * grid row is only as short as its tallest cell. Columns balance the height instead,
       * so a one-page section beside a six-page one leaves no hole. `columns: 13rem 3` is
       * "at most three, none narrower than 13rem", which collapses to one on a phone.
       */
      .page {
        max-width: 60rem;
        margin: 0 auto;
        padding: var(--fs-spacing-10) var(--fs-spacing-5) var(--fs-spacing-16);
        columns: 13rem 3;
        column-gap: var(--fs-spacing-8);
      }
      .section {
        display: grid;
        gap: var(--fs-spacing-2);
        break-inside: avoid;
        margin-block-end: var(--fs-spacing-8);
      }
      /* The heading only, in the wordmark's blue. Enough to find, not enough to look broken. */
      .section[data-featured] h2 {
        color: var(--fs-color-accent-fill);
      }
      .section ul {
        margin: 0;
        padding: 0;
        list-style: none;
        display: grid;
        gap: var(--fs-spacing-1);
      }
    </style>
  </body>
</html>
