---
import { Code } from "astro:components"
import sobernetics from "../assets/sobernetics.svg?raw"
import CodeBlock from "../components/CodeBlock.astro"
import Logo from "../components/Logo.astro"
import VersionBadge from "../components/VersionBadge.astro"
import { SERVICE } from "../config"
import { fence } from "../fences"
import feed13 from "../generated/feed-13.sse?raw"
import { FAVICON } from "../icon"
import { NAVIGATION } from "../navigation"
import {
  CLAIM,
  CORPUS_CASES,
  DESCRIPTION,
  KTOR_VERSION,
  MAVEN_GROUP,
  MERGE_SCENARIOS,
  TAGLINE,
  VERSION,
} from "../project"
import samples from "../samples/front-page.md?raw"
import { datastarLangs, hangingIndent, shikiThemes } from "../shiki"
import "../styles/global.css"

// What /feed sends from 13, frame by frame, as the test panel shows it before the assertions.
// Written by ./gradlew :docs-samples:checkDocSamples from the service's own handler and
// encoder, and stale in CI the day either changes; never typed here.
const FEED_FRAMES = feed13.trim().split("\n\n")

// The one section of the list the hero has just made a promise about, so the eye should find
// it without being shouted at. Named here rather than in the markup, because it is a choice.
const FEATURED = "The tooling"

// Written the way it would be written, not the way a phone would like it. A narrow screen
// wraps the long line with a hanging indent (see hangingIndent in src/shiki.ts), and this
// block is a poster on every screen wide enough to hold it, which is most of them.
//
// The Kotlin on this page comes from samples/front-page.md, which docs-samples compiles with the
// pages' own fences, so none of it can outlive the API it shows. The page tells one story with
// it: the feed built, tested, broken by accident, and caught.
const SAMPLE = fence(samples, "feed")

// The problem section: four mistakes that compile, ship and do nothing in the browser, each with
// what happens and what stops it. Two are the analysis's, two the SDK's. The verdicts are the
// analysis's own: both of the first two are errors, so the CI test fails on them, not only the
// editor. The markup one is HTML and not Kotlin, so it is written here and highlighted as HTML.
const MISTAKES = [
  {
    title: "Kotlin takes the dollar",
    code: fence(samples, "mistake-dollar"),
    lang: "kotlin",
    what: "Kotlin puts 13 where `$heads` stood. The browser gets `13++`, and the button does nothing.",
    caught: "Your editor, and CI",
    href: "/dollar-trap/",
  },
  {
    title: "A modifier with a dot",
    code: `<form data-on:submit.prevent="@post('/heads')">`,
    lang: "html",
    what: "Datastar waits for an event named `submit.prevent`, which never comes. The form posts the old way and the page reloads.",
    caught: "Your editor, and CI",
    href: "/editors/",
  },
  {
    title: "A patch with nowhere to go",
    code: fence(samples, "mistake-selector"),
    lang: "kotlin",
    what: "Append needs a selector, and the browser rejects the event without one. Streamlord throws where you build it instead.",
    caught: "The SDK, before a byte is sent",
    href: "/protocol/#the-eight-patch-modes",
  },
  {
    title: "An event that never leaves",
    code: fence(samples, "mistake-flush"),
    lang: "kotlin",
    what: "Written by hand without a flush, the event waits in a buffer, on an open stream for minutes. Streamlord flushes every event.",
    caught: "The SDK, on every event",
    href: "/introduction/",
  },
]

// The handler above is what streamlord-live runs at /feed: the count comes from the page's
// signals and goes back one higher, so a press from 13 is 14. These two lines are what a test
// says about that response; both names are streamlord-test's own. The test panel runs exactly
// these against a fresh stream from 13, whatever the page counts.
const ASSERTED = fence(samples, "asserted")

// The page the feed lives on, with the button every Kotlin project first writes. The editor
// panel draws it, and the CI panel's field holds its one wrong line.
const BROKEN = fence(samples, "broken").split("\n")
const TRAP = "$heads"
const TRAP_LINE = BROKEN.findIndex((line) => line.includes(TRAP))
if (TRAP_LINE < 0) throw new Error(`the broken page has no ${TRAP}`)

// What the judge's field holds on arrival: the broken feed's wrong line.
const PREFILL = BROKEN[TRAP_LINE].trim()

// Three more, each a different verdict: a near-miss attribute, a modifier with the wrong
// separator, and a hyphen the browser reads as part of a signal's name. The third is Kotlin,
// so the reader sees both analyses answer.
const TRIES = [
  { label: "data-onn:click", source: `<button data-onn:click="1">` },
  { label: "click.prevent", source: `<div data-on:click.prevent="$go()">` },
  { label: "$a-b in Kotlin", source: `dataText("\${'$'}a-b")` },
]

// A JavaScript string literal for a Datastar expression. Single quotes, so the double quotes
// the snippets are full of need no escaping, and the client leaves a `$` inside a string alone.
const js = (text: string) =>
  `'${text.replace(/\\/g, "\\\\").replace(/'/g, "\\'")}'`

// The editors' diagnostic on the prefill, word for word as the analysis writes it, and the
// fixes it offers in the order it offers them. The judge on this page says the same; the
// frame below shows where it is said in an editor.
// Kotlin's idiom for a literal dollar, in two halves so the linter does not read it as a placeholder.
const IDIOM = "$" + "{'$'}"
const DIAGNOSTIC = `Kotlin interpolates $heads here; the browser will never see a signal. Write signal("heads"), make the literal $$"..." (Kotlin 2.2+), or escape as ${IDIOM}heads.`
const DIAGNOSTIC_CODE = "kotlin-interpolation"
const QUICK_FIXES = [
  `Use increment("heads")`,
  "Make it a $$ literal, where $heads is a signal",
  `Escape as ${IDIOM}heads`,
  "Escape as \\$heads",
]

// The broken page, split around its strings so the editor frame can colour them, and around
// the trap so the frame can underline it, as the analysis does, and hang the hover under it.
const STRING = /("(?:[^"\\]|\\.)*")/
const BROKEN_LINES = BROKEN.map((text, index) => {
  if (index !== TRAP_LINE) return { trap: false, parts: text.split(STRING) }
  const at = text.indexOf(TRAP)
  const open = text.lastIndexOf('"', at)
  const close = text.indexOf('"', at)
  return {
    trap: true,
    before: text.slice(0, open),
    rest: text.slice(at + TRAP.length, close),
    after: text.slice(close + 1),
    parts: [],
  }
})

const VSCODE =
  "https://marketplace.visualstudio.com/items?itemName=MarkusAugust.streamlord"
const INTELLIJ = "https://plugins.jetbrains.com/plugin/34587-streamlord"

// The test from the testing page that reads a project's own sources, as it stands there.
const CI_TEST = fence(samples, "ci-test")

const DEPENDENCY = `testImplementation("${MAVEN_GROUP}:streamlord-analysis:${VERSION}")`

// The four cards are tabs, in the order of the story: build, test, break and see it in the
// editor, and the CI check for the day the editor is ignored. Each carries one number the build reads from the repository,
// so none of them can go stale on its own. The version catalog names Ktor; it names the
// Spring Framework rather than Boot, and Boot 4 is what manages that Framework, so Boot's
// major is written here beside the Ktor the catalog gives.
const TOOLS = [
  {
    id: "sdk",
    title: "The SDK",
    line: "Adapters for Ktor and Spring over one core.",
    fact: `Ktor ${KTOR_VERSION.split(".").slice(0, 2).join(".")} and Spring Boot 4`,
  },
  {
    id: "test",
    title: "Assert what it sent",
    line: "Read the response back. Assert what you meant.",
    fact: `${MERGE_SCENARIOS} scenarios held to the client's own mergePatch`,
  },
  {
    id: "editors",
    title: "The editors",
    line: "VS Code and IntelliJ, with the fix a click away.",
    fact: `${CORPUS_CASES} cases both editors judge alike`,
  },
  {
    id: "analysis",
    title: "The CI check",
    line: "One test walks src/main/kotlin and fails on a swallowed signal.",
    fact: "Runs in CI. No editor needed.",
  },
]
---

<!doctype html>
<!--
  The landing page is dark, always, whatever the reader or their system has chosen. It is one
  page and it is a poster: the mark, the neon and the deep ground were drawn for each other,
  and a light variant of them is a different poster. Every other page follows the reader.

  The consequence is honest and worth naming: someone who prefers light gets dark here and
  light from the next click onward. The masthead on those pages keeps the same dark band, so
  the top of the screen at least stays continuous.
-->
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Streamlord: a Datastar toolchain for Kotlin</title>
    <meta
      name="description"
      content={DESCRIPTION}
    />
    <link rel="canonical" href={Astro.site} />
    <link rel="icon" href={FAVICON} type="image/svg+xml" />
    <!--
      Datastar, because the page runs the example rather than printing it. The tabs, the
      buttons and the judge's field are attributes and signals against streamlord-live, and
      there is no script of ours between a press and the server.
    -->
    <script
      type="module"
      src="https://cdn.jsdelivr.net/gh/starfederation/datastar@v1.0.4/bundles/datastar.js"
    ></script>
  </head>
  <body>
    <a class="lt-skip-link" href="#content">Skip to content</a>

    <!--
      Neon needs somewhere dark to be neon, and a muted variant for a light theme would lose
      the colour exactly where it is doing the work.

      The band is deeper than the page's own dark surface because that is the ground the mark
      was drawn on. Everything else reads its colours from the tokens.
    -->
    <header class="hero">
      <div class="hero__inner">
        <div class="hero__brand">
          <Logo size={72} />
          <h1 class="hero__word">Streamlord</h1>
          <VersionBadge />
        </div>
        <div class="hero__main">
          <p class="hero__line">{CLAIM}</p>
          <p class="hero__sub">
            {TAGLINE} An SDK for Ktor and Spring, assertions for your tests, an analysis for your
            CI, and two editor extensions.
          </p>

          <!--
            The reader here has chosen Datastar and is choosing a library for it, so the row
            reads as the journey they are actually on: proof that this one works, then the
            reason to take it over the official SDK, then the way in. Install is a need you
            have after deciding, and it is one screen down in the list below.
          -->
          <div class="hero__actions">
            <!-- Linked only now that the service it talks to exists outside this machine. -->
            <a class="lt-button" href="/live/">See it run</a>
            <a class="lt-button" data-variant="secondary" href="/editors/">The editors</a>
            <a class="lt-button" data-variant="ghost" href="/first-stream/">Your first stream</a>
          </div>
        </div>

        <!--
          The creed beside the promise, not before it: the name runs across the top, the eye
          reads the line and the buttons down the left, and the manifesto stands in the room
          the hero had to spare. On
          a phone there is no beside, so it follows the buttons, after everything a reader came
          for. The last two lines are the whole argument for Datastar.
        -->
        <figure class="creed">
          <blockquote class="creed__words">
            <p>The elders of Bonereach asked Gorvek what a warrior wants of a stream.</p>
            <p>
              "That it flows when I say flow. That it stops when I say stop. That it carries
              my will to the far shore, and nothing else."
            </p>
            <p>"And the JavaScript?"</p>
            <p>"I do not know the word."</p>
          </blockquote>
          <figcaption class="creed__who">
            Gorvek of Bonereach, who walked out of the Ashfall with iron in his hand
          </figcaption>
        </figure>
      </div>
    </header>

    <main class="page" id="content">
      <!--
        The problem, said once and before the tools: Datastar is written in strings, and every
        mistake in a string compiles. Four of them, each with what the browser does and what
        stops it, so a reader knows what the tabs below are for before they open one.
      -->
      <section class="block">
        <h2 class="lt-heading" data-size="m">Datastar lives in strings your compiler never reads.</h2>
        <p class="block__lead">
          Each of these compiles, and without Streamlord you find out in the browser. Streamlord
          stops all four: the first two in your editor and in CI, the last two in the SDK itself.
        </p>

        <div class="problems">
          {
            MISTAKES.map((mistake) => (
              <article class="lt-card problem">
                <h3 class="lt-card__title">{mistake.title}</h3>
                <div class="sample sample--wrap">
                  <Code
                    code={mistake.code}
                    lang={mistake.lang}
                    themes={shikiThemes}
                    langs={datastarLangs}
                    transformers={[hangingIndent]}
                  />
                </div>
                <p class="lt-paragraph problem__what" data-size="small">
                  {mistake.what.split("`").map((part, at) => (at % 2 === 1 ? <code>{part}</code> : part))}
                </p>
                <p class="problem__caught">
                  Caught by: {mistake.caught}
                  <span class="map__dot" aria-hidden="true"> · </span>
                  <a class="lt-link" href={mistake.href}>More</a>
                </p>
              </article>
            ))
          }
        </div>

        <p class="block__lead">
          The tabs below follow the first one, <code>dataOnClick("$heads++")</code>, through all
          four tools.
        </p>
      </section>

      <!--
        One stage, four tools. Every signal the stage uses stands on this element, and so
        before any `data-on-signal-patch` below it: in the other order the client sees `source`
        arrive and posts once on load. `tool` picks the panel; `heads` and `wire` are the feed's,
        `broken` the test's, `source` the judge's.
      -->
      <section
        class="block stage"
        data-signals={`{tool: 'sdk', heads: 13, wire: true, broken: false, source: ${js(PREFILL)}}`}
      >
        <h2 class="lt-heading" data-size="m">Four tools, designed together.</h2>
        <p class="block__lead">
          One feed, from start to finish: built, tested, broken by accident, and caught. Adopt
          one tool, or all four.
        </p>

        <!-- The cards are the tabs: a button each, selected by the signal, so Tab and Enter work as they do anywhere. -->
        <div class="tools" role="tablist" aria-label="The four tools">
          {
            TOOLS.map((tool) => (
              <button
                class="lt-card tool"
                data-interactive
                type="button"
                role="tab"
                id={`tab-${tool.id}`}
                aria-controls={`panel-${tool.id}`}
                aria-selected={tool.id === "sdk" ? "true" : "false"}
                data-on:click={`$tool = '${tool.id}'`}
                data-attr:aria-selected={`$tool === '${tool.id}' ? 'true' : 'false'`}
              >
                <span class="lt-card__title">{tool.title}</span>
                <span class="lt-paragraph tool__line" data-size="small">{tool.line}</span>
                <span class="tool__fact">{tool.fact}</span>
              </button>
            ))
          }
        </div>

        <!--
          The panels, one shown at a time. The three that are not the first start hidden in the
          markup as well, so the page does not flash all four before the client has run.
        -->
        <div class="scene">
          <!-- 1. The SDK: the handler, run, and the frames it put on the wire. -->
          <div
            class="scene__panel"
            role="tabpanel"
            id="panel-sdk"
            aria-labelledby="tab-sdk"
            data-show="$tool === 'sdk'"
          >
            <p class="block__lead">
              Build the feed. The handler reads the count from the page and sends back one more.
            </p>

            <div class="sample">
              <Code
                code={SAMPLE}
                lang="kotlin"
                themes={shikiThemes}
                langs={datastarLangs}
                transformers={[hangingIndent]}
              />
            </div>

            <!--
              The handler above, run. The count the server reads is the one on the page: 13 on
              arrival, one more per press. `wire` tells the service there is a #wire to patch
              the frames into, as the live page does.

              Reset is a route too: no attribute removes what the server appended (data-text
              on the list would undo the appends themselves), so the server patches the list
              and the frames empty, which is Datastar's one way to clear a container. Disabled
              until there is something to reset.
            -->
            <div class="run">
              <div class="run__row">
                <button class="lt-button" type="button" data-on:click={`@get('${SERVICE}/feed')`}>
                  Run it
                </button>
                <button
                  class="lt-button"
                  data-variant="secondary"
                  type="button"
                  disabled
                  data-attr:disabled="$heads === 13"
                  data-on:click={`@get('${SERVICE}/feed/reset')`}
                >
                  Reset
                </button>
                <p class="run__heads">
                  <code>$heads</code>
                  <span class="run__count" data-text="$heads"></span>
                </p>
              </div>

              <ul id="feed" class="run__feed" aria-live="polite"></ul>

              <div class="run__wire">
                <p class="run__label">On the wire</p>
                <!-- Beside #wire, not in it, so a reset that empties the frames brings it back. -->
                <p class="lt-paragraph run__empty" data-size="small" data-show="$heads === 13">
                  Press Run. The frames the server sends come back here, encoded by the same
                  encoder the golden-file tests check.
                </p>
                <div id="wire" class="run__frames"></div>
              </div>

              <p class="run__label">Asserted the same way in your tests:</p>
              <div class="sample sample--wrap">
                <Code
                  code={ASSERTED}
                  lang="kotlin"
                  themes={shikiThemes}
                  langs={datastarLangs}
                  transformers={[hangingIndent]}
                />
              </div>
            </div>
          </div>

          <!--
            2. The test: a fresh stream from 13, shown first, then read back by streamlord-test
            and held to the two lines. Nothing to type: Run runs the test as written, and Break
            runs it expecting 99, so the reader sees what a failure prints. The server reads
            `broken` and nothing else; the count on the page plays no part.
          -->
          <div
            class="scene__panel"
            role="tabpanel"
            id="panel-test"
            aria-labelledby="tab-test"
            data-show="$tool === 'test'"
            style="display: none"
          >
            <p class="block__lead">
              Test the feed. The stream, read back by the test reader and held to two lines.
            </p>

            <p class="run__label">What <code>/feed</code> sends, counting from 13:</p>
            <div class="assert__frames">{FEED_FRAMES.map((frame) => <pre class="wire__frame">{frame}</pre>)}</div>

            <p class="run__label">The test:</p>
            <div class="sample sample--wrap">
              <Code
                code={ASSERTED}
                lang="kotlin"
                themes={shikiThemes}
                langs={datastarLangs}
                transformers={[hangingIndent]}
              />
            </div>

            <div class="assert__row">
              <button class="lt-button" type="button" data-on:click={`$broken = false; @post('${SERVICE}/assert')`}>
                Run this test
              </button>
              <button
                class="lt-button"
                data-variant="secondary"
                type="button"
                data-on:click={`$broken = true; @post('${SERVICE}/assert')`}
              >
                Break it
              </button>
            </div>

            <div id="assertion" class="assert__box" aria-live="polite">
              <p class="lt-paragraph" data-size="small">
                Run it and the test is green. Break it and the test expects 99 instead, and the
                reader's own failure lands here, stream and all.
              </p>
            </div>
          </div>

          <!--
            3. The editors: the feed broken by accident, where the editor shows it. The frame is
            markup and CSS drawn from the broken fence; the diagnostic is the analysis's own
            text, and the hover is :hover and :focus-visible, so the keyboard reaches it too.
          -->
          <div
            class="scene__panel"
            role="tabpanel"
            id="panel-editors"
            aria-labelledby="tab-editors"
            data-show="$tool === 'editors'"
            style="display: none"
          >
            <p class="block__lead">
              Break it by accident. The page that holds the feed gets a button, and Kotlin
              takes <code>{TRAP}</code> for itself. Hover the string.
            </p>

            <div class="ed" aria-label="An editor window">
              <div class="ed__bar" aria-hidden="true">
                <span class="ed__dot"></span><span class="ed__dot"></span><span class="ed__dot"></span>
                <span class="ed__file">Wall.kt</span>
              </div>
              {/* The lines are blocks, so no newline stands between them: in a pre it would be a line of its own. */}
              <pre class="ed__code"><code>{BROKEN_LINES.map((line, index) => (
                <span class="ed__line" style={`--indent: ${BROKEN[index].search(/\S|$/)}`}><span class="ed__n" aria-hidden="true">{index + 1}</span>{line.trap ? (
                  <Fragment>{line.before}<span class="ed__str">"<span class="ed__trap" tabindex="0" aria-describedby="ed-tip">{TRAP}</span><span class="ed__tip" role="tooltip" id="ed-tip"><span class="ed__msg">{DIAGNOSTIC} <span class="ed__source">streamlord(<span class="ed__link">{DIAGNOSTIC_CODE}</span>)</span></span><span class="ed__fixes-title">Quick fixes</span><ul class="ed__fixes">{QUICK_FIXES.map((fix) => <li>{fix}</li>)}</ul></span>{line.rest}"</span>{line.after}</Fragment>
                ) : line.parts.map((part, at) => (at % 2 === 1 ? <span class="ed__str">{part}</span> : part))}</span>
              ))}</code></pre>
            </div>

            <p class="ed__where">
              Both editors say this.
              <a class="lt-link" href={VSCODE}>VS Code Marketplace</a>
              <span class="map__dot" aria-hidden="true"> · </span>
              <a class="lt-link" href={INTELLIJ}>JetBrains Marketplace</a>
            </p>
          </div>

          <!--
            4. The CI check: the editors' analysis behind a route. The field binds `source`, the
            three buttons set it, and the panel watches that one signal and posts, debounced,
            so every way of changing the text reaches the judge the same way. It arrives
            holding the broken feed's wrong line.
          -->
          <div
            class="scene__panel judge"
            role="tabpanel"
            id="panel-analysis"
            aria-labelledby="tab-analysis"
            data-show="$tool === 'analysis'"
            style="display: none"
            data-on-signal-patch__debounce.300ms={`@post('${SERVICE}/judge')`}
            data-on-signal-patch-filter="{include: /^source$/}"
          >
            <p class="block__lead">
              Ignore the editor, and CI stops it anyway. The test below runs the same analysis
              over <code>src/main/kotlin</code>. Type, and it judges.
            </p>

            <label class="lt-label" for="source">Markup or Kotlin</label>
            <textarea
              class="lt-textarea judge__source"
              id="source"
              rows="3"
              maxlength="1024"
              spellcheck="false"
              data-bind:source
            ></textarea>

            <div class="judge__tries">
              <span class="judge__or">Or try</span>
              {
                TRIES.map((attempt) => (
                  <button
                    class="lt-button"
                    data-variant="secondary"
                    type="button"
                    data-on:click={`$source = ${js(attempt.source)}`}
                  >
                    <code>{attempt.label}</code>
                  </button>
                ))
              }
            </div>

            <div id="verdict" class="judge__box" aria-live="polite">
              <p class="lt-paragraph judge__how" data-size="small">
                Change a character, or press one of the three, and the verdict lands here.
              </p>
            </div>
          </div>
        </div>
      </section>

      <section class="block">
        <h2 class="lt-heading" data-size="m">Try it on the repo you have open right now.</h2>
        <p class="block__lead">
          One dependency and one test, and every Datastar string under{" "}
          <code>src/main/kotlin</code> is read before it ships.{" "}
          <a class="lt-link" href="/analysis/">More on the analysis</a>
        </p>
        <div class="sample">
          <Code
            code={DEPENDENCY}
            lang="kotlin"
            themes={shikiThemes}
            langs={datastarLangs}
            transformers={[hangingIndent]}
          />
        </div>
        <div class="sample">
          <Code
            code={CI_TEST}
            lang="kotlin"
            themes={shikiThemes}
            langs={datastarLangs}
            transformers={[hangingIndent]}
          />
        </div>
      </section>
    </main>

    <!--
      The foot of the poster on the same ground as its head: the map and the mark sit on the
      hero's deep colour, so the page opens and closes dark around the lit stage in the middle.
    -->
    <div class="foot">
      <!-- The whole site, a section a column, so the foot of the poster is also its map. -->
      <nav class="map" aria-label="All pages">
      {
        NAVIGATION.map((section) => (
          <section class="section" data-featured={section.title === FEATURED ? "" : undefined}>
            <h2 class="lt-heading" data-size="s">{section.title}</h2>
            <ul class="lt-list" data-variant="plain">
              {section.pages.map((page) => (
                <li>
                  <a class="lt-link" href={`/${page.slug}/`}>
                    {page.title}
                  </a>
                </li>
