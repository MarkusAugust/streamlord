---
import { Code } from "astro:components"
import sobernetics from "../assets/sobernetics.svg?raw"
import CodeBlock from "../components/CodeBlock.astro"
import Logo from "../components/Logo.astro"
import VersionBadge from "../components/VersionBadge.astro"
import { SERVICE } from "../config"
import { FAVICON } from "../icon"
import { NAVIGATION } from "../navigation"
import {
  CORPUS_CASES,
  DESCRIPTION,
  KTOR_VERSION,
  MAVEN_GROUP,
  MERGE_SCENARIOS,
  TAGLINE,
  VERSION,
} from "../project"
import { datastarLangs, hangingIndent, shikiThemes } from "../shiki"
import "../styles/global.css"

// The one section of the list the hero has just made a promise about, so the eye should find
// it without being shouted at. Named here rather than in the markup, because it is a choice.
const FEATURED = "The tooling"

// Written the way it would be written, not the way a phone would like it. A narrow screen
// wraps the long line with a hanging indent (see hangingIndent in src/shiki.ts), and this
// block is a poster on every screen wide enough to hold it, which is most of them.
const SAMPLE = `get("/feed") {
    call.respondDatastar {
        patchElements(selector = "#feed", mode = ElementPatchMode.APPEND) {
            li { +"A new head hangs on the wall" }
        }
        patchSignals("heads" to 13)
    }
}`

// The handler above is what streamlord-live runs at /feed, with one difference: the count
// comes from the page's signals and goes back one higher, so a press from 13 is 14. These two
// lines are what a test says about that response; both names are streamlord-test's own.
const ASSERTED = `events.assertPatchElements(selector = "#feed", mode = ElementPatchMode.APPEND, containing = "A new head")
events.assertSignal("heads", 14)`

// What the judge's field holds on arrival: the one mistake every Kotlin project makes first.
const PREFILL = `dataOnClick("$count++")`

// Three more, each a different verdict: a near-miss attribute, a modifier with the wrong
// separator, and a hyphen the browser reads as part of a signal's name. The third is Kotlin,
// so the reader sees both analyses answer.
const TRIES = [
  { label: "data-onn:click", source: `<button data-onn:click="1">` },
  { label: "click.prevent", source: `<div data-on:click.prevent="$go()">` },
  { label: "$a-b in Kotlin", source: `dataText("\${'$'}a-b")` },
]

// A JavaScript string literal for a Datastar expression. Single quotes, so the double quotes
// the snippets are full of need no escaping, and the client leaves a `$` inside a string alone.
const js = (text: string) =>
  `'${text.replace(/\\/g, "\\\\").replace(/'/g, "\\'")}'`

// The editors' diagnostic on the prefill, word for word as the analysis writes it, and the
// fixes it offers in the order it offers them. The judge on this page says the same; the
// frame below shows where it is said in an editor.
// Kotlin's idiom for a literal dollar, in two halves so the linter does not read it as a placeholder.
const IDIOM = "$" + "{'$'}"
const DIAGNOSTIC = `Kotlin interpolates $count here; the browser will never see a signal. Write signal("count"), make the literal $$"..." (Kotlin 2.2+), or escape as ${IDIOM}count.`
const DIAGNOSTIC_CODE = "kotlin-interpolation"
const QUICK_FIXES = [
  `Use increment("count")`,
  "Make it a $$ literal, where $count is a signal",
  `Escape as ${IDIOM}count`,
  "Escape as \\$count",
]

const VSCODE =
  "https://marketplace.visualstudio.com/items?itemName=MarkusAugust.streamlord"
const INTELLIJ = "https://plugins.jetbrains.com/plugin/34587-streamlord"

// The test from the testing page that reads a project's own sources, as it stands there.
const CI_TEST = `private val analyzer = Analyzer()

@Test
fun \`no source file interpolates a signal into Datastar\`() {
    val offenders =
        java.io.File("src/main/kotlin")
            .walkTopDown()
            .filter { it.extension == "kt" }
            .flatMap { file ->
                val source = file.readText()
                analyzer
                    .analyzeKotlin(source)
                    .filter { it.severity == Severity.ERROR }
                    .map { it.format(file.path, source) }
            }.toList()

    assertTrue(offenders.isEmpty(), offenders.joinToString("\\n"))
}`

const DEPENDENCY = `testImplementation("${MAVEN_GROUP}:streamlord-analysis:${VERSION}")`

// The four cards are tabs, and each carries one number the build reads from the repository,
// so none of them can go stale on its own. The version catalog names Ktor; it names the
// Spring Framework rather than Boot, and Boot 4 is what manages that Framework, so Boot's
// major is written here beside the Ktor the catalog gives.
const TOOLS = [
  {
    id: "sdk",
    title: "The SDK",
    line: "Adapters for Ktor and Spring over one core.",
    fact: `Ktor ${KTOR_VERSION.split(".").slice(0, 2).join(".")} and Spring Boot 4`,
  },
  {
    id: "test",
    title: "Test assertions",
    line: "Read the response back. Assert what you meant.",
    fact: `${MERGE_SCENARIOS} scenarios held to the client's own mergePatch`,
  },
  {
    id: "analysis",
    title: "The analysis",
    line: "One test walks src/main/kotlin and fails on a swallowed signal.",
    fact: "Runs in CI. No editor needed.",
  },
  {
    id: "editors",
    title: "The editors",
    line: "VS Code and IntelliJ, with the fix a click away.",
    fact: `${CORPUS_CASES} cases both editors judge alike`,
  },
]
---

<!doctype html>
<!--
  The landing page is dark, always, whatever the reader or their system has chosen. It is one
  page and it is a poster: the mark, the neon and the deep ground were drawn for each other,
  and a light variant of them is a different poster. Every other page follows the reader.

  The consequence is honest and worth naming: someone who prefers light gets dark here and
  light from the next click onward. The masthead on those pages keeps the same dark band, so
  the top of the screen at least stays continuous.
-->
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Streamlord: a Datastar toolchain for Kotlin</title>
    <meta
      name="description"
      content={DESCRIPTION}
    />
    <link rel="canonical" href={Astro.site} />
    <link rel="icon" href={FAVICON} type="image/svg+xml" />
    <!--
      Datastar, because the page runs the example rather than printing it. The tabs, the
      buttons and the judge's field are attributes and signals against streamlord-live, and
      there is no script of ours between a press and the server.
    -->
    <script
      type="module"
      src="https://cdn.jsdelivr.net/gh/starfederation/datastar@v1.0.4/bundles/datastar.js"
    ></script>
  </head>
  <body>
    <a class="fs-skip-link" href="#content">Skip to content</a>

    <!--
      Neon needs somewhere dark to be neon, and a muted variant for a light theme would lose
      the colour exactly where it is doing the work.

      The band is deeper than the page's own dark surface because that is the ground the mark
      was drawn on. Everything else reads its colours from the tokens.
    -->
    <header class="hero">
      <div class="hero__inner">
        <Logo size={72} />
        <h1 class="hero__word">Streamlord</h1>
        <VersionBadge />
        <p class="hero__line">{TAGLINE}</p>
        <p class="hero__sub">
          An SDK for Ktor and Spring, assertions for your tests, an analysis for your CI, and
          two editor extensions.
        </p>

        <!--
          The reader here has chosen Datastar and is choosing a library for it, so the row
          reads as the journey they are actually on: proof that this one works, then the
          reason to take it over the official SDK, then the way in. Install is a need you
          have after deciding, and it is one screen down in the list below.
        -->
        <div class="hero__actions">
          <!-- Linked only now that the service it talks to exists outside this machine. -->
          <a class="fs-button" href="/live/">See it run</a>
          <a class="fs-button" data-variant="secondary" href="/editors/">The editors</a>
          <a class="fs-button" data-variant="ghost" href="/first-stream/">Your first stream</a>
        </div>

        <!--
          The creed the README opens with, which the site itself had nowhere to put. It belongs
          on the poster and not on a reference page: the last two lines are the whole argument
          for Datastar, and they make it faster than the paragraph above ever could.
        -->
        <figure class="creed">
          <blockquote class="creed__words">
            <p>The elders of Bonereach asked Gorvek what a warrior wants of a stream.</p>
            <p>
              "That it flows when I say flow. That it stops when I say stop. That it carries
              my will to the far shore, and nothing else."
            </p>
            <p>"And the JavaScript?"</p>
            <p>"I do not know the word."</p>
          </blockquote>
          <figcaption class="creed__who">
            Gorvek of Bonereach, who walked out of the Ashfall with iron in his hand
          </figcaption>
        </figure>
      </div>
    </header>

    <main class="page" id="content">
      <!--
        One stage, four tools. Every signal the stage uses stands on this element, and so
        before any `data-on-signal-patch` below it: in the other order the client sees `source`
        arrive and posts once on load. `tool` picks the panel; `heads` and `wire` are the feed's,
        `expect` the test's, `source` the judge's.
      -->
      <section
        class="block stage"
        data-signals={`{tool: 'sdk', heads: 13, wire: true, expect: 14, source: ${js(PREFILL)}}`}
      >
        <h2 class="fs-heading" data-size="m">Four tools, designed together.</h2>
        <p class="block__lead">One mistake, one stream, four ways to see it. Adopt one, or all of them.</p>

        <!-- The cards are the tabs: a button each, selected by the signal, so Tab and Enter work as they do anywhere. -->
        <div class="tools" role="tablist" aria-label="The four tools">
          {
            TOOLS.map((tool) => (
              <button
                class="fs-card tool"
                data-interactive
                type="button"
                role="tab"
                id={`tab-${tool.id}`}
                aria-controls={`panel-${tool.id}`}
                aria-selected={tool.id === "sdk" ? "true" : "false"}
                data-on:click={`$tool = '${tool.id}'`}
                data-attr:aria-selected={`$tool === '${tool.id}' ? 'true' : 'false'`}
              >
                <span class="fs-card__title">{tool.title}</span>
                <p class="fs-paragraph" data-size="small">{tool.line}</p>
                <span class="tool__fact">{tool.fact}</span>
              </button>
            ))
          }
        </div>

        <!--
          The panels, one shown at a time. The three that are not the first start hidden in the
          markup as well, so the page does not flash all four before the client has run.
        -->
        <div class="scene">
          <!-- 1. The SDK: the handler, run, and the frames it put on the wire. -->
          <div
            class="scene__panel"
            role="tabpanel"
            id="panel-sdk"
            aria-labelledby="tab-sdk"
            data-show="$tool === 'sdk'"
          >
            <div class="sample">
              <Code
                code={SAMPLE}
                lang="kotlin"
                themes={shikiThemes}
                langs={datastarLangs}
                transformers={[hangingIndent]}
              />
            </div>

            <!--
              The handler above, run. The count the server reads is the one on the page: 13 on
              arrival, one more per press. `wire` tells the service there is a #wire to patch
              the frames into, as the live page does.
            -->
            <div class="run">
              <div class="run__row">
                <button class="fs-button" type="button" data-on:click={`@get('${SERVICE}/feed')`}>
                  Run it
                </button>
                <p class="run__heads">
                  <code>$heads</code>
                  <span class="run__count" data-text="$heads"></span>
                </p>
              </div>

              <ul id="feed" class="run__feed" aria-live="polite"></ul>

              <div class="run__wire">
                <p class="run__label">On the wire</p>
                <div id="wire" class="run__frames">
                  <p class="fs-paragraph" data-size="small">
                    Press Run. The frames the server sends come back here, encoded by the same
                    encoder the golden-file tests check.
                  </p>
                </div>
              </div>

              <p class="run__label">Asserted the same way in your tests:</p>
              <div class="sample sample--wrap">
                <Code
                  code={ASSERTED}
                  lang="kotlin"
                  themes={shikiThemes}
                  langs={datastarLangs}
                  transformers={[hangingIndent]}
                />
              </div>
            </div>
          </div>

          <!-- 2. The test: the same stream, read back by streamlord-test and held to two lines. -->
          <div
            class="scene__panel"
            role="tabpanel"
            id="panel-test"
            aria-labelledby="tab-test"
            data-show="$tool === 'test'"
            style="display: none"
          >
            <p class="block__lead">The same stream, read by the test reader.</p>

            <div class="assert__row">
              <label class="fs-label" for="expect">expect heads to be</label>
              <input class="fs-input assert__expect" id="expect" type="number" min="0" max="10000" data-bind:expect />
              <button class="fs-button" type="button" data-on:click={`@post('${SERVICE}/assert')`}>
                Assert it
              </button>
            </div>
            <p class="assert__note">
              The feed counts on from <code data-text="$heads"></code>, as a press of Run does.
            </p>

            <!-- The two lines a test says, with the field's number where the test's would be. -->
            <pre class="asserts"><code>events.assertPatchElements(selector = <span class="asserts__str">"#feed"</span>, mode = ElementPatchMode.APPEND, containing = <span class="asserts__str">"A new head"</span>)
events.assertSignal(<span class="asserts__str">"heads"</span>, <span class="asserts__num" data-text="$expect">14</span>)</code></pre>

            <div id="assertion" class="assert__box" aria-live="polite">
              <p class="fs-paragraph" data-size="small">
                Press Assert. Green when the stream says what the field says; the reader's own
                failure, stream and all, when it does not.
              </p>
            </div>
          </div>

          <!--
            3. The analysis: the editors' check behind a route. The field binds `source`, the
            three buttons set it, and the panel watches that one signal and posts, debounced,
            so every way of changing the text reaches the judge the same way.
          -->
          <div
            class="scene__panel judge"
            role="tabpanel"
            id="panel-analysis"
            aria-labelledby="tab-analysis"
            data-show="$tool === 'analysis'"
            style="display: none"
            data-on-signal-patch__debounce.300ms={`@post('${SERVICE}/judge')`}
            data-on-signal-patch-filter="{include: /^source$/}"
          >
            <p class="block__lead">The same analysis your editor and your CI run. Type, and it judges.</p>

            <label class="fs-label" for="source">Markup or Kotlin</label>
            <textarea
              class="fs-textarea judge__source"
              id="source"
              rows="3"
              maxlength="1024"
              spellcheck="false"
              data-bind:source
            ></textarea>

            <div class="judge__tries">
              <span class="judge__or">Or try</span>
              {
                TRIES.map((attempt) => (
                  <button
                    class="fs-button"
                    data-variant="secondary"
                    type="button"
                    data-on:click={`$source = ${js(attempt.source)}`}
                  >
                    <code>{attempt.label}</code>
                  </button>
                ))
              }
            </div>

            <div id="verdict" class="judge__box" aria-live="polite">
              <p class="fs-paragraph judge__how" data-size="small">
                Change a character, or press one of the three, and the verdict lands here.
              </p>
            </div>
          </div>

          <!--
            4. The editors: the same mistake where the editor shows it. The frame is markup and
            CSS; the diagnostic is the analysis's own text, and the hover is :hover and
            :focus-visible, so the keyboard reaches it too.
          -->
          <div
            class="scene__panel"
            role="tabpanel"
            id="panel-editors"
            aria-labelledby="tab-editors"
            data-show="$tool === 'editors'"
            style="display: none"
          >
            <p class="block__lead">The same mistake, where the editor shows it. Hover the string.</p>

            <div class="ed" aria-label="An editor window">
              <div class="ed__bar" aria-hidden="true">
                <span class="ed__dot"></span><span class="ed__dot"></span><span class="ed__dot"></span>
                <span class="ed__file">Wall.kt</span>
              </div>
              {/* The lines are blocks, so no newline stands between them: in a pre it would be a line of its own. */}
              <pre class="ed__code"><code><span class="ed__line"><span class="ed__n" aria-hidden="true">1</span>button {"{"}</span><span class="ed__line"><span class="ed__n" aria-hidden="true">2</span>    dataOnClick(<span class="ed__str">"<span class="ed__trap" tabindex="0" aria-describedby="ed-tip">$count++</span><span class="ed__tip" role="tooltip" id="ed-tip"><span class="ed__msg">{DIAGNOSTIC} <span class="ed__source">streamlord(<span class="ed__link">{DIAGNOSTIC_CODE}</span>)</span></span><span class="ed__fixes-title">Quick fixes</span><ul class="ed__fixes">{QUICK_FIXES.map((fix) => <li>{fix}</li>)}</ul></span>"</span>)</span><span class="ed__line"><span class="ed__n" aria-hidden="true">3</span>    +<span class="ed__str">"Hang a head"</span></span><span class="ed__line"><span class="ed__n" aria-hidden="true">4</span>{"}"}</span></code></pre>
            </div>

            <p class="ed__where">
              Both editors say this.
              <a class="fs-link" href={VSCODE}>VS Code Marketplace</a>
              <span class="map__dot" aria-hidden="true"> · </span>
              <a class="fs-link" href={INTELLIJ}>JetBrains Marketplace</a>
            </p>
          </div>
        </div>
      </section>

      <section class="block">
        <h2 class="fs-heading" data-size="m">Try it on the repo you have open right now.</h2>
        <p class="block__lead">
          One dependency and one test, and every Datastar string under{" "}
          <code>src/main/kotlin</code> is read before it ships.
        </p>
        <div class="sample">
          <Code
            code={DEPENDENCY}
            lang="kotlin"
            themes={shikiThemes}
            langs={datastarLangs}
            transformers={[hangingIndent]}
          />
        </div>
        <div class="sample">
          <Code
            code={CI_TEST}
            lang="kotlin"
            themes={shikiThemes}
            langs={datastarLangs}
            transformers={[hangingIndent]}
          />
        </div>
      </section>
    </main>

    <!-- The whole site, a section a column, so the foot of the poster is also its map. -->
    <nav class="map" aria-label="All pages">
      {
        NAVIGATION.map((section) => (
          <section class="section" data-featured={section.title === FEATURED ? "" : undefined}>
            <h2 class="fs-heading" data-size="s">{section.title}</h2>
            <ul class="fs-list" data-variant="plain">
              {section.pages.map((page) => (
                <li>
                  <a class="fs-link" href={`/${page.slug}/`}>
                    {page.title}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </nav>

    <footer class="colophon">
      <a class="sobernetics" href="https://sobernetics.no"><Fragment set:html={sobernetics} /></a>
    </footer>

    <CodeBlock />

    <style>
      /* The foot of the page: a rule and real room above it, so the mark reads as a signature
         under the content rather than as another line of it. */
      .colophon {
        max-width: 60rem;
        margin: var(--fs-spacing-16) auto var(--fs-spacing-10);
        padding: var(--fs-spacing-5) var(--fs-spacing-6) 0;
        border-top: 1px solid var(--fs-color-neutral-border-subtle);
      }

      /* The Søbernetics mark. Small on purpose, and small is the whole of how it stays quiet: the
         opacity this first had took it to 3.5:1 against the ground, which is below the contrast
         required of a link, and on one page left it all but invisible. Subtlety is size, not a
         washed-out colour.

         The red is Søbernetics' own, set here per theme rather than taken from the host's accent
         token. Streamlord's accent is a blue, so the mark arrived there wearing Streamlord's colour,
         and a mark that changes hue per project is not a mark. */
      .sobernetics {
        --sobernetics-accent: #c8102e;
        display: inline-block;
        color: var(--fs-color-neutral-text-subtle);
      }

      @media (prefers-color-scheme: dark) {
        :root:not([data-theme="light"]) .sobernetics { --sobernetics-accent: #f44851; }
      }

      :root[data-theme="dark"] .sobernetics { --sobernetics-accent: #f44851; }

      .sobernetics:hover,
      .sobernetics:focus-visible {
        color: var(--fs-color-neutral-text-strong);
      }

      /* `:global` because the mark arrives through `set:html`. Astro stamps its scope id on
         elements it can see in the template, and an injected child is not one of them, so a
         plain descendant selector here reaches nothing and the drawing collapses to no height
         at all. This is the one rule that has to cross the scope. */
      .sobernetics :global(svg) {
        display: block;
        height: 18px;
        width: auto;
      }

      .hero {
        /* Deeper than the page's own dark surface: this is the ground the mark was drawn on. */
        background: #0c0d14;
        color: var(--fs-color-neutral-text-strong);
        border-block-end: 1px solid rgba(0, 177, 250, 0.25);
      }
      .hero__inner {
        max-width: 60rem;
        margin: 0 auto;
        padding: var(--fs-spacing-12) var(--fs-spacing-5) var(--fs-spacing-10);
        display: grid;
        justify-items: start;
        gap: var(--fs-spacing-4);
      }
      .hero__word {
        margin: 0;
        /* The floor is a phone: at 2.5rem the word alone measured 330px of a 390px screen. */
        font-size: clamp(2rem, 9vw, 4.5rem);
        line-height: 1;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        /* Flat, so the logo beside it is the only gradient on the screen. */
        color: var(--fs-color-accent-fill);
      }
      .hero__line {
        margin: 0;
        font-size: var(--fs-font-size-l);
        color: var(--fs-color-neutral-text-strong);
      }
      .hero__sub {
        margin: 0;
        max-width: 46ch;
        color: var(--fs-color-neutral-text-subtle);
        line-height: var(--fs-line-height-article);
      }
      .hero__actions {
        display: flex;
        flex-wrap: wrap;
        gap: var(--fs-spacing-3);
        margin-block-start: var(--fs-spacing-2);
      }

      /* Quiet, and set off by the same neon the border above uses, at a quarter strength. */
      .creed {
        margin: var(--fs-spacing-6) 0 0;
        max-width: 46ch;
        padding-inline-start: var(--fs-spacing-4);
        border-inline-start: 2px solid rgba(0, 177, 250, 0.35);
        color: var(--fs-color-neutral-text-subtle);
      }
      .creed__words {
        margin: 0;
        font-style: italic;
        line-height: var(--fs-line-height-article);
      }
      .creed__words p {
        margin: 0 0 var(--fs-spacing-2);
      }
      .creed__words p:last-child {
        margin-block-end: 0;
      }
      .creed__who {
        margin: var(--fs-spacing-3) 0 0;
        font-size: var(--fs-font-size-s);
        font-style: normal;
      }

      .page {
        max-width: 60rem;
        margin: 0 auto;
        padding: var(--fs-spacing-10) var(--fs-spacing-5) 0;
        display: grid;
        gap: var(--fs-spacing-12);
        /* One column that may shrink below its content, or the widest block sets the page. */
        grid-template-columns: minmax(0, 1fr);
      }
      .block {
        display: grid;
        gap: var(--fs-spacing-3);
        justify-items: start;
        min-inline-size: 0;
      }
      .block > .fs-heading {
        margin: 0;
      }
      .block__lead {
        margin: 0;
        max-width: 60ch;
        color: var(--fs-color-neutral-text-subtle);
        line-height: var(--fs-line-height-article);
      }
      .block__lead code {
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      }

      /*
       * Every code block on the page.
       *
       * A grid item may not shrink below its content by default, and `pre` does not wrap,
       * so this one measured 666px inside a 390px phone. The column grew to fit it, the
       * document became 686px wide, and the dark ground ended mid-screen. Zero minimum, and
       * the column can be as narrow as the phone; then the code scrolls inside its own box.
       */
      .sample {
        inline-size: 100%;
        min-inline-size: 0;
      }
      .sample :global(pre),
      .asserts {
        margin: 0;
        padding: var(--fs-spacing-4);
        border-radius: var(--fs-spacing-1);
        border: 1px solid rgba(0, 177, 250, 0.2);
        overflow-x: auto;
        /*
         * Down a step on a phone and no further: below about 11px a monospace font stops
         * being read and starts being decoded. The sample is written narrow enough that this
         * is the whole of it. The scroll below is a safety net, not the plan.
         */
        font-size: clamp(0.7rem, 2.9vw, var(--fs-font-size-s));
      }
      .sample :global(code),
      .asserts {
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      }
      /* The same hanging indent the articles use, for a screen narrower than this sample. */
      .sample :global(pre code) {
        white-space: normal;
      }
      .sample :global(pre .line) {
        display: block;
        white-space: pre;
        min-block-size: 1lh;
      }
      /* The assertion is one long call, and a wrapped call reads better than a scrolled one at
         any width; the poster above keeps its shape until a phone. */
      @media (max-width: 40rem) {
        .sample :global(pre .line) {
          white-space: pre-wrap;
          overflow-wrap: break-word;
          padding-inline-start: calc(var(--indent, 0) * 1ch + 2ch);
          text-indent: calc((var(--indent, 0) * 1ch + 2ch) * -1);
        }
      }
      .sample--wrap :global(pre .line) {
        white-space: pre-wrap;
        overflow-wrap: break-word;
        padding-inline-start: calc(var(--indent, 0) * 1ch + 2ch);
        text-indent: calc((var(--indent, 0) * 1ch + 2ch) * -1);
      }

      /* The four cards, as tabs: four across at full width, two on a tablet, one on a phone. */
      .tools {
        inline-size: 100%;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(13rem, 100%), 1fr));
        gap: var(--fs-spacing-3);
      }
      .tool {
        inline-size: 100%;
        align-items: start;
        color: inherit;
      }
      .tool .fs-card__title {
        color: var(--fs-color-accent-fill);
      }
      .tool p {
        color: var(--fs-color-neutral-text-subtle);
      }
      .tool__fact {
        margin-block-start: auto;
        padding-block-start: var(--fs-spacing-1);
        font-size: var(--fs-font-size-xs);
        font-weight: var(--fs-font-weight-semibold);
        color: var(--fs-color-neutral-text-strong);
      }
      /* The chosen card: the neon border the hero uses, at full strength, and nothing else moves. */
      .tool[aria-selected="true"] {
        border-color: var(--fs-color-accent-fill);
        box-shadow: inset 0 -2px 0 var(--fs-color-accent-fill);
      }

      .scene {
        inline-size: 100%;
        min-inline-size: 0;
      }
      .scene__panel {
        display: grid;
        gap: var(--fs-spacing-3);
        justify-items: start;
        min-inline-size: 0;
      }

      /* The example, run. The server writes into the list and the frames, so both are :global. */
      .run {
        inline-size: 100%;
        min-inline-size: 0;
        display: grid;
        gap: var(--fs-spacing-3);
      }
      .run__row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--fs-spacing-4);
      }
      .run__heads {
        margin: 0;
        color: var(--fs-color-neutral-text-subtle);
      }
      .run__heads code,
      .assert__note code {
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      }
      .run__count {
        margin-inline-start: var(--fs-spacing-1);
        font-weight: var(--fs-font-weight-bold);
        font-variant-numeric: tabular-nums;
        color: var(--fs-color-accent-fill);
      }
      .run__feed {
        margin: 0;
        padding: 0;
        list-style: none;
        display: grid;
        gap: var(--fs-spacing-1);
      }
      .run__feed :global(li) {
        padding: var(--fs-spacing-1) var(--fs-spacing-3);
        border-inline-start: 2px solid var(--fs-color-accent-fill);
        font-size: var(--fs-font-size-s);
      }
      .run__feed :global(.feed__verdict) {
        border-inline-start-color: var(--fs-color-warning-text);
        color: var(--fs-color-neutral-text-subtle);
      }
      .run__label {
        margin: 0;
        font-size: var(--fs-font-size-xxs);
        font-weight: var(--fs-font-weight-semibold);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--fs-color-neutral-text-subtle);
      }
      .run__wire {
        display: grid;
        gap: var(--fs-spacing-2);
        /* A frame is one long line until it wraps, and a wide one must not widen the page. */
        min-inline-size: 0;
        overflow-wrap: anywhere;
      }
      .run__frames {
        display: grid;
        gap: var(--fs-spacing-2);
      }
      .run__frames > p {
        margin: 0;
        color: var(--fs-color-neutral-text-subtle);
      }
      /* The frames, as the live page shows them: the server writes these, so they are styled here. */
      .run__frames :global(.wire__frame) {
        margin: 0;
        padding: var(--fs-spacing-3);
        overflow-x: auto;
        background: var(--fs-color-neutral-surface);
        border-radius: var(--fs-spacing-1);
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: var(--fs-font-size-xs);
        line-height: var(--fs-line-height-compact);
        white-space: pre-wrap;
        overflow-wrap: anywhere;
      }

      /* The test: a field, a button and the two lines, then the reader's verdict. */
      .assert__row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--fs-spacing-3);
      }
      .assert__expect {
        inline-size: 6rem;
        font-variant-numeric: tabular-nums;
      }
      .assert__note {
        margin: 0;
        font-size: var(--fs-font-size-s);
        color: var(--fs-color-neutral-text-subtle);
      }
      .asserts {
        inline-size: 100%;
        box-sizing: border-box;
        line-height: var(--fs-line-height-compact);
        color: var(--fs-color-neutral-text-strong);
        white-space: pre-wrap;
        overflow-wrap: break-word;
      }
      .asserts__str {
        color: var(--fs-color-neutral-text-subtle);
      }
      .asserts__num {
        font-weight: var(--fs-font-weight-bold);
        color: var(--fs-color-accent-fill);
      }
      .assert__box {
        inline-size: 100%;
        max-inline-size: 48rem;
        min-block-size: 3rem;
        display: grid;
        gap: var(--fs-spacing-2);
        overflow-wrap: anywhere;
      }
      .assert__box > p {
        margin: 0;
        color: var(--fs-color-neutral-text-subtle);
      }
      /* The reader's failure, as it prints it: the message, a blank line, and the stream event by event. */
      .assert__box :global(.assertion__said) {
        margin: 0;
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: var(--fs-font-size-xs);
        line-height: var(--fs-line-height-compact);
        white-space: pre-wrap;
        overflow-wrap: anywhere;
      }

      .judge__source {
        inline-size: 100%;
        max-inline-size: 48rem;
        box-sizing: border-box;
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: var(--fs-font-size-s);
      }
      .judge__tries {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--fs-spacing-2);
      }
      .judge__tries code {
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: var(--fs-font-size-s);
      }
      .judge__or {
        font-size: var(--fs-font-size-s);
        color: var(--fs-color-neutral-text-subtle);
      }
      /* The verdict is written by the server in Fristil's classes, so what is left to style is ours. */
      .judge__box {
        inline-size: 100%;
        max-inline-size: 48rem;
        min-block-size: 3rem;
        display: grid;
        gap: var(--fs-spacing-2);
        overflow-wrap: anywhere;
      }
      .judge__box :global(.judge__how) {
        margin: 0;
        color: var(--fs-color-neutral-text-subtle);
      }
      .judge__box :global(.judge__findings) {
        margin: 0;
        padding: 0;
        display: grid;
        gap: var(--fs-spacing-2);
      }
      .judge__box :global(.judge__finding) {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--fs-spacing-1) var(--fs-spacing-2);
      }
      .judge__box :global(.judge__severity) {
        font-size: var(--fs-font-size-xxs);
        font-weight: var(--fs-font-weight-semibold);
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }
      .judge__box :global(.judge__code) {
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: var(--fs-font-size-xs);
        color: var(--fs-color-neutral-text-subtle);
      }

      /*
       * The editor window. Drawn, not screenshotted, so the diagnostic in it is the text the
       * analysis writes today and the hover works at every width. The colours are an editor's
       * dark theme, not the site's tokens, because the frame is a picture of another program.
       */
      .ed {
        inline-size: 100%;
        max-inline-size: 48rem;
        box-sizing: border-box;
        border: 1px solid rgba(0, 177, 250, 0.2);
        border-radius: var(--fs-spacing-1);
        background: #1e1e1e;
        color: #d4d4d4;
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: clamp(0.75rem, 2.9vw, var(--fs-font-size-s));
      }
      .ed__bar {
        display: flex;
        align-items: center;
        gap: var(--fs-spacing-2);
        padding: var(--fs-spacing-2) var(--fs-spacing-3);
        border-block-end: 1px solid #333;
        font-size: var(--fs-font-size-xs);
        color: #9d9d9d;
      }
      .ed__dot {
        inline-size: 10px;
        block-size: 10px;
        border-radius: 50%;
        background: #3c3c3c;
      }
      .ed__file {
        margin-inline-start: var(--fs-spacing-2);
      }
      .ed__code {
        margin: 0;
        padding: var(--fs-spacing-3) var(--fs-spacing-3) var(--fs-spacing-4);
        line-height: 1.7;
        /* The tooltip is positioned against the line it hangs under, so the lines are blocks. */
        white-space: pre;
      }
      .ed__line {
        display: block;
        position: relative;
      }
      .ed__n {
        display: inline-block;
        inline-size: 2.5ch;
        margin-inline-end: 1.5ch;
        text-align: end;
        color: #6e7681;
        user-select: none;
      }
      .ed__str {
        color: #ce9178;
      }
      /* The trap, as the editor marks it: a red wave under the string, and the eye goes there first. */
      .ed__trap {
        text-decoration: underline wavy #f14c4c;
        text-decoration-skip-ink: none;
        text-underline-offset: 3px;
        cursor: help;
        border-radius: 2px;
      }
      .ed__trap:focus-visible {
        outline: 1px solid #0078d4;
        outline-offset: 1px;
      }
      /* The hover. Hidden until the string is hovered or focused, and it stays while the pointer is on it. */
      .ed__tip {
        visibility: hidden;
        position: absolute;
        z-index: 1;
        inset-inline: 0;
        top: 100%;
        margin-block-start: 2px;
        display: grid;
        gap: var(--fs-spacing-2);
        padding: var(--fs-spacing-3);
        border: 1px solid #454545;
        border-radius: 3px;
        background: #252526;
        color: #d4d4d4;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.5);
        white-space: normal;
        line-height: var(--fs-line-height-compact);
        overflow-wrap: anywhere;
      }
      .ed__trap:hover ~ .ed__tip,
      .ed__trap:focus-visible ~ .ed__tip,
      .ed__tip:hover {
        visibility: visible;
      }
      .ed__msg {
        display: block;
      }
      .ed__source {
        color: #9d9d9d;
      }
      .ed__link {
        color: #3794ff;
        text-decoration: underline;
      }
      .ed__fixes-title {
        display: block;
        padding-block-start: var(--fs-spacing-2);
        border-block-start: 1px solid #454545;
        font-size: var(--fs-font-size-xs);
        color: #9d9d9d;
      }
      .ed__fixes {
        margin: 0;
        padding: 0;
        list-style: none;
        display: grid;
        gap: var(--fs-spacing-1);
        color: #3794ff;
      }
      .ed__where {
        margin: 0;
        font-size: var(--fs-font-size-s);
        color: var(--fs-color-neutral-text-subtle);
      }

      /*
       * Multi-column, not a grid: the sections are lists of very different lengths, and a
       * grid row is only as short as its tallest cell. Columns balance the height instead,
       * so a one-page section beside a six-page one leaves no hole. `columns: 13rem 3` is
       * "at most three, none narrower than 13rem", which collapses to one on a phone.
       */
      .map {
        max-width: 60rem;
        margin: 0 auto;
        padding: var(--fs-spacing-16) var(--fs-spacing-5) 0;
        columns: 13rem 3;
        column-gap: var(--fs-spacing-8);
      }
      .section {
        display: grid;
        gap: var(--fs-spacing-2);
        break-inside: avoid;
        margin-block-end: var(--fs-spacing-8);
      }
      /* The heading only, in the wordmark's blue. Enough to find, not enough to look broken. */
      .section[data-featured] h2 {
        color: var(--fs-color-accent-fill);
      }
      .section ul {
        margin: 0;
        padding: 0;
        list-style: none;
        display: grid;
        gap: var(--fs-spacing-1);
      }
      .map__dot {
        color: var(--fs-color-neutral-text-subtle);
      }
    </style>
  </body>
</html>
