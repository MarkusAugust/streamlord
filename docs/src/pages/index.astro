---
import { Code } from "astro:components"
import Logo from "../components/Logo.astro"
import { FAVICON } from "../icon"
import { NAVIGATION } from "../navigation"
import { datastarLangs, shikiThemes } from "../shiki"
import "../styles/global.css"

const SAMPLE = `get("/feed") {
    call.respondDatastar {
        patchElements(selector = "#feed", mode = ElementPatchMode.APPEND) {
            li { +"A new head hangs on the wall" }
        }
        patchSignals("heads" to 13)
    }
}`
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Streamlord — a Kotlin SDK for Datastar</title>
    <meta
      name="description"
      content="Streamlord speaks the Datastar 1.0.4 Server-Sent Events protocol from Kotlin, over Ktor and Spring, and brings nothing you do not already carry."
    />
    <link rel="canonical" href={Astro.site} />
    <link rel="icon" href={FAVICON} type="image/svg+xml" />
    <script is:inline>
      try {
        const saved = localStorage.getItem("theme")
        if (saved === "light" || saved === "dark") {
          document.documentElement.dataset.theme = saved
        }
      } catch {}
    </script>
  </head>
  <body>
    <a class="fs-skip-link" href="#content">Skip to content</a>

    <!--
      The hero keeps its dark ground in both themes. Neon needs somewhere dark to be neon,
      and a muted variant for the light theme would lose the colour exactly where it is
      doing the work. The rest of the page follows the reader's choice as usual.
    -->
    <header class="hero">
      <div class="hero__inner">
        <Logo size={72} />
        <h1 class="hero__word">Streamlord</h1>
        <p class="hero__line">A Kotlin SDK for Datastar 1.0.4.</p>
        <p class="hero__sub">
          It speaks the Server-Sent Events protocol exactly, reads the signals the browser
          sends back, and serves Ktor and Spring without favour. It brings nothing you do not
          already carry.
        </p>

        <div class="hero__sample">
          <Code code={SAMPLE} lang="kotlin" themes={shikiThemes} langs={datastarLangs} />
        </div>

        <div class="hero__actions">
          <a class="fs-button" href="/first-stream/">Your first stream</a>
          <a class="fs-button" data-variant="secondary" href="/install/">Install and modules</a>
        </div>
      </div>
    </header>

    <main class="page" id="content">
      {
        NAVIGATION.map((section) => (
          <section class="section">
            <h2 class="fs-heading" data-size="s">{section.title}</h2>
            <ul class="fs-list" data-variant="plain">
              {section.pages.map((page) => (
                <li>
                  <a class="fs-link" href={`/${page.slug}/`}>
                    {page.title}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </main>

    <style>
      .hero {
        /* The dark ground, in both themes. */
        background: #0c0d14;
        color: #f1f5ff;
        border-block-end: 1px solid rgba(0, 177, 250, 0.25);
      }
      .hero__inner {
        max-width: 60rem;
        margin: 0 auto;
        padding: var(--size-12) var(--size-5) var(--size-10);
        display: grid;
        justify-items: start;
        gap: var(--size-4);
      }
      .hero__word {
        margin: 0;
        font-size: clamp(2.5rem, 9vw, 4.5rem);
        line-height: 1;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        /* Flat, so the logo beside it is the only gradient on the screen. */
        color: var(--palette-interactive-50);
      }
      .hero__line {
        margin: 0;
        font-size: var(--font-size-l);
        color: #f1f5ff;
      }
      .hero__sub {
        margin: 0;
        max-width: 46ch;
        color: #a7b4c6;
        line-height: var(--semantic-line-height-article);
      }
      .hero__sample {
        inline-size: 100%;
        margin-block-start: var(--size-3);
      }
      .hero__sample :global(pre) {
        margin: 0;
        padding: var(--size-4);
        border-radius: var(--size-1);
        border: 1px solid rgba(0, 177, 250, 0.2);
        overflow-x: auto;
        font-size: var(--font-size-s);
      }
      .hero__sample :global(code) {
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      }
      .hero__actions {
        display: flex;
        flex-wrap: wrap;
        gap: var(--size-3);
        margin-block-start: var(--size-2);
      }

      .page {
        max-width: 60rem;
        margin: 0 auto;
        padding: var(--size-10) var(--size-5) var(--size-16);
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
        gap: var(--size-8);
        align-items: start;
      }
      .section {
        display: grid;
        gap: var(--size-2);
      }
      .section ul {
        margin: 0;
        padding: 0;
        list-style: none;
        display: grid;
        gap: var(--size-1);
      }
    </style>
  </body>
</html>
