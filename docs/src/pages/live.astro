---
import { fs } from "@fristil/designsystem"
import Logo from "../components/Logo.astro"
import ThemeRestore from "../components/ThemeRestore.astro"
import ThemeToggle from "../components/ThemeToggle.astro"
import { SERVICE } from "../config"
import { FAVICON } from "../icon"
import "../styles/global.css"

// A page that runs the library rather than describing it. Everything below the search field
// is written by streamlord-live: the results, the frames, and the signal the count lives in.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Live | Streamlord</title>
    <meta
      name="description"
      content="The documentation's search, answered by Streamlord over Server-Sent Events, with the frames it sent beside it."
    />
    <link rel="icon" href={FAVICON} type="image/svg+xml" />
    <script type="module" src="https://cdn.jsdelivr.net/gh/starfederation/datastar@v1.0.4/bundles/datastar.js"
    ></script>

    <ThemeRestore />
  </head>

  <body>
    <a class="fs-skip-link" href="#content">Skip to content</a>

    <header class="masthead" data-theme="dark">
      <a class="masthead__brand" href="/">
        <Logo size={26} />
        <span>Streamlord</span>
      </a>
      <span class="masthead__where">Live</span>
      <div class="masthead__tools">
        <ThemeToggle />
      </div>
    </header>

    <main class="page" id="content" data-signals="{query: '', total: 0, wire: true}">
      <h1 class="fs-heading" data-size="l">The search, answered by Streamlord</h1>
      <p class="fs-paragraph" data-variant="lead">
        Every keystroke is a real request. The server reads the signal the browser sends,
        searches the documentation, and patches the results into this page. Nothing here is
        recorded, and there is no JavaScript of ours on the page.
      </p>

      <!--
        fs.search() rather than the classes by hand. Fristil's search field is an fs-input
        with room for a magnifier, so it needs both classes, and writing only fs-search gets
        you a half-styled field with no error anywhere, which is exactly what happened here
        before this line. The builder sets both, and type="search" with them.

        role="search" makes the row a landmark, so a screen reader finds the field without
        tabbing to it.
      -->
      <div class="search" role="search">
        <label class="fs-label" for="q">Search the documentation</label>
        <div class="fs-search-row">
          <input
            {...fs.search()}
            id="q"
            placeholder="patch mode, casing, readSignals…"
            data-bind:query
            data-indicator:searching
            data-on:input__debounce.300ms={`@get('${SERVICE}/search')`}
          />
          <!--
            A real button, because the cross the browser draws inside a type="search" field
            is a pseudo-element and Chrome does not let the keyboard reach it. Firefox draws
            none at all. This one is a tab stop, clears the bound signal (which empties the
            field, since the binding runs both ways) and asks for the empty result.
          -->
          <button
            class="fs-button"
            data-variant="secondary"
            type="button"
            data-show="$query"
            data-on:click={`$query = ''; @get('${SERVICE}/search')`}
          >
            Clear
          </button>
        </div>
      </div>

      <div class="panels">
        <section class="panel">
          <h2 class="panel__title" id="results-title">
            Results <span class="panel__count" data-text="$total ? `(${$total})` : ''"></span>
            <span class="panel__busy" data-show="$searching">…</span>
          </h2>
          <!--
            A live region, because the server patches these in silently. Datastar replaces the
            contents and the page says nothing: a keyboard or screen-reader user types, an
            answer arrives, and nothing announces it. aria-live is how a patched DOM is made
            perceivable, and aria-busy follows the indicator so the announcement waits for the
            request to finish rather than reading a half-filled panel.
          -->
          <div
            id="results"
            class="panel__body"
            role="region"
            aria-labelledby="results-title"
            aria-live="polite"
            data-attr:aria-busy="$searching"
          >
            <p class="fs-paragraph" data-size="small">Type to search the documentation.</p>
          </div>
        </section>

        <section class="panel">
          <h2 class="panel__title">Signals</h2>
          <p class="panel__note">
            Datastar's own store, rendered by <code>data-json-signals</code>. No code of ours.
          </p>
          <pre class="panel__body panel__json" data-json-signals></pre>
        </section>

        <!--
          The eight patch modes, each one a press.

          Every button sets a signal and asks the same endpoint, so what differs between them is
          one word on the wire. The stone carries an input on purpose: morphing keeps what you
          typed into it and replacing does not, which is the difference between the two halves
          of the table on the protocol page and is invisible in prose.
        -->
        <section class="panel panel--wide" data-signals="{mode: 'inner', lastMode: ''}">
          <h2 class="panel__title">The eight patch modes</h2>
          <p class="panel__note">
            One endpoint, one word of difference. Type into the stone, then press Outer and
            Replace: a morph keeps what you wrote, a replacement does not.
          </p>

          <div class="gallery__modes">
            <button
              class="fs-button"
              data-variant="secondary"
              type="button"
              data-on:click={`$mode = 'inner'; @get('${SERVICE}/modes')`}
              data-attr:aria-pressed="$lastMode === 'inner'"
            >Inner</button>
            <button
              class="fs-button"
              data-variant="secondary"
              type="button"
              data-on:click={`$mode = 'outer'; @get('${SERVICE}/modes')`}
              data-attr:aria-pressed="$lastMode === 'outer'"
            >Outer</button>
            <button
              class="fs-button"
              data-variant="secondary"
              type="button"
              data-on:click={`$mode = 'replace'; @get('${SERVICE}/modes')`}
              data-attr:aria-pressed="$lastMode === 'replace'"
            >Replace</button>
            <button
              class="fs-button"
              data-variant="secondary"
              type="button"
              data-on:click={`$mode = 'prepend'; @get('${SERVICE}/modes')`}
              data-attr:aria-pressed="$lastMode === 'prepend'"
            >Prepend</button>
            <button
              class="fs-button"
              data-variant="secondary"
              type="button"
              data-on:click={`$mode = 'append'; @get('${SERVICE}/modes')`}
              data-attr:aria-pressed="$lastMode === 'append'"
            >Append</button>
            <button
              class="fs-button"
              data-variant="secondary"
              type="button"
              data-on:click={`$mode = 'before'; @get('${SERVICE}/modes')`}
              data-attr:aria-pressed="$lastMode === 'before'"
            >Before</button>
            <button
              class="fs-button"
              data-variant="secondary"
              type="button"
              data-on:click={`$mode = 'after'; @get('${SERVICE}/modes')`}
              data-attr:aria-pressed="$lastMode === 'after'"
            >After</button>
            <button
              class="fs-button"
              data-variant="secondary"
              type="button"
              data-on:click={`$mode = 'remove'; @get('${SERVICE}/modes')`}
              data-attr:aria-pressed="$lastMode === 'remove'"
            >Remove</button>
            <button
              class="fs-button"
              data-variant="ghost"
              type="button"
              data-on:click={`$mode = 'reset'; @get('${SERVICE}/modes')`}
            >Rebuild the wall</button>
          </div>

          <div class="gallery">
            <div id="wall" class="gallery__wall">
              <p id="stone" class="gallery__stone">
                <span class="gallery__says">A stone in the wall. Aim the eight modes at it.</span>
                <input class="fs-input gallery__chisel" id="chisel" placeholder="Type here, then press Outer and Replace" />
              </p>
            </div>

            <div id="modes-said" class="gallery__said-box">
              <p class="fs-paragraph" data-size="small">
                What the server sent will appear here: the mode, the selector, and the elements.
              </p>
            </div>
          </div>
        </section>

        <!--
          Validation, decided where it has to be decided anyway.

          The inputs are never patched. Replacing an element somebody is typing into moves
          their caret, so the server sends the *text* of each fault as a signal and the page
          binds it: data-text for the message, data-attr for aria-invalid. The summary is the
          opposite case and arrives as markup, because it only exists when something is wrong
          and it is built from Fristil classes the server has never seen.
        -->
        <section
          class="panel panel--wide"
          data-signals="{banner: '', swords: '', bannerFault: '', swordsFault: '', mustered: false}"
        >
          <h2 class="panel__title">A form, checked on the server</h2>
          <p class="panel__note">
            The rules live in Kotlin, once. Nothing that arrives over a network may be trusted,
            so the server has to check anyway, and a second copy of the rules in the browser is
            a copy that goes out of step.
          </p>

          <form class="muster" data-on:submit__prevent={`@post('${SERVICE}/muster')`}>
            <div class="fs-field muster__field">
              <label class="fs-label" for="banner">Name of the banner</label>
              <input
                class="fs-input"
                id="banner"
                type="text"
                placeholder="The Ashen Vow"
                data-bind:banner
                data-attr:aria-invalid="$bannerFault ? 'true' : null"
                data-attr:aria-describedby="$bannerFault ? 'banner-error' : null"
                data-on:input__debounce.400ms={`@post('${SERVICE}/muster')`}
              />
              <p
                class="fs-error-text"
                id="banner-error"
                data-show="$bannerFault"
                data-text="$bannerFault"
              ></p>
            </div>

            <div class="fs-field muster__field">
              <label class="fs-label" for="swords">Sworn swords</label>
              <input
                class="fs-input"
                id="swords"
                type="text"
                inputmode="numeric"
                placeholder="120"
                data-bind:swords
                data-attr:aria-invalid="$swordsFault ? 'true' : null"
                data-attr:aria-describedby="$swordsFault ? 'swords-error' : null"
                data-on:input__debounce.400ms={`@post('${SERVICE}/muster')`}
              />
              <p
                class="fs-error-text"
                id="swords-error"
                data-show="$swordsFault"
                data-text="$swordsFault"
              ></p>
            </div>

            <button class="fs-button" type="submit">Muster</button>
          </form>

          <!-- Written by the server, in the design system's own classes. -->
          <div id="muster-summary" class="muster__summary">
            <p class="fs-paragraph" data-size="small">
              Nothing has been sent yet. Type, and the server will answer every four hundred
              milliseconds.
            </p>
          </div>
        </section>

        <!--
          The counter: one connection, thirty numbers, and a button that stops it.

          The button is both Start and Stop, and that is not a shortcut. It is how Datastar
          cancels. A request keeps an AbortController per method and URL, so asking the
          same endpoint again, from this button or any other, aborts the stream that is still open before the
          new request is sent. The server reads `running` from the signals it was sent, sees
          that a stream was already going, and answers by putting the page back in order
          instead of starting another one. No state on this page, and no JavaScript.
        -->
        <section class="panel panel--wide" data-signals="{running: false, count: 0}">
          <h2 class="panel__title">
            A stream that stays open
            <span class="panel__count" data-text="$running ? `${$count}` : ''"></span>
          </h2>
          <p class="panel__note">
            One <code>Flow</code>, one connection, twelve seconds. Every number is an element
            patch and a signal patch on the same open response. Nothing here is polled.
          </p>

          <div class="counter">
            <button
              class="fs-button"
              type="button"
              data-on:click={`@get('${SERVICE}/counter')`}
              data-text="$running ? 'Stop' : 'Start counting'"></button>

            <div id="counter" class="counter__face" aria-live="polite">
              <p class="counter__number">0</p>
              <p class="fs-paragraph counter__state" data-size="small">
                Press Start. The server will hold the connection open and write here.
              </p>
            </div>
          </div>
        </section>

        <section class="panel panel--wide">
          <h2 class="panel__title">On the wire</h2>
          <p class="panel__note">
            The frames the server sent, encoded by the same <code>SseEncoder</code> the
            golden-file tests verify. Not a description of them. The frames.
          </p>
          <div id="wire" class="panel__body">
            <p class="fs-paragraph" data-size="small">Nothing sent yet.</p>
          </div>
        </section>
      </div>
    </main>

    <style>
      /* The same band as the documentation shell, down to the two grounds: the reason for
         each one is written out over .masthead in Page.astro. */
      .masthead {
        display: flex;
        align-items: center;
        gap: var(--fs-spacing-3);
        padding: var(--fs-spacing-3) var(--fs-spacing-5);
        background: #2c436b;
        border-block-end: 1px solid
          color-mix(in oklab, var(--fs-color-accent-fill) 25%, transparent);
      }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme="light"]) .masthead {
          background: #0c0d14;
        }
      }
      :root[data-theme="dark"] .masthead {
        background: #0c0d14;
      }
      .masthead__tools {
        margin-inline-start: auto;
      }
      /* Same swap as the shell's masthead, and for the same reason. */
      .masthead .fs-button[data-variant="ghost"]:hover {
        background: var(--fs-color-accent-text);
        color: var(--fs-color-accent-surface);
      }
      .masthead__brand {
        display: flex;
        align-items: center;
        gap: var(--fs-spacing-2);
        font-weight: var(--font-weight-bold);
        font-size: var(--font-size-l);
        color: var(--fs-color-neutral-text-strong);
        text-decoration: none;
      }
      .masthead__where {
        color: var(--fs-color-accent-fill);
        font-size: var(--font-size-s);
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .page {
        max-width: 72rem;
        margin: 0 auto;
        padding: var(--fs-spacing-8) var(--fs-spacing-5) var(--fs-spacing-16);
        display: grid;
        gap: var(--fs-spacing-4);
      }
      .page > p {
        max-width: 60ch;
        margin: 0;
      }

      .search {
        display: grid;
        gap: var(--fs-spacing-1);
        max-width: 32rem;
        margin-block-start: var(--fs-spacing-4);
      }
      /* Ours replaces it, and two crosses in one field is one too many. */
      .search :global(.fs-search::-webkit-search-cancel-button) {
        display: none;
      }

      .panels {
        margin-block-start: var(--fs-spacing-6);
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
        gap: var(--fs-spacing-5);
      }
      .panel {
        display: grid;
        gap: var(--fs-spacing-2);
        align-content: start;
        padding: var(--fs-spacing-4);
        border: 1px solid var(--fs-color-neutral-border-subtle);
        border-radius: var(--fs-spacing-1);
      }
      .panel--wide {
        grid-column: 1 / -1;
      }
      .panel__title {
        margin: 0;
        font-size: var(--font-size-xxs);
        font-weight: var(--font-weight-semibold);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--fs-color-neutral-text-subtle);
      }
      .panel__count,
      .panel__busy {
        color: var(--fs-color-accent-fill);
      }
      .panel__note {
        margin: 0;
        font-size: var(--font-size-xs);
        color: var(--fs-color-neutral-text-subtle);
      }
      .panel__body {
        min-height: 3rem;
      }
      .gallery__modes {
        display: flex;
        flex-wrap: wrap;
        gap: var(--fs-spacing-2);
      }
      .gallery {
        margin-block-start: var(--fs-spacing-4);
        display: grid;
        gap: var(--fs-spacing-4);
        grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
        align-items: start;
      }
      .gallery__wall {
        display: grid;
        gap: var(--fs-spacing-2);
        align-content: start;
        min-block-size: 8rem;
        padding: var(--fs-spacing-4);
        border: 1px dashed var(--fs-color-neutral-border-subtle);
        border-radius: var(--fs-spacing-1);
      }
      .gallery :global(.gallery__stone) {
        margin: 0;
        display: grid;
        gap: var(--fs-spacing-2);
        padding: var(--fs-spacing-3);
        border-radius: var(--fs-spacing-1);
        background: var(--fs-color-neutral-surface);
      }
      .gallery :global(.gallery__course) {
        margin: 0;
        padding: var(--fs-spacing-2) var(--fs-spacing-3);
        border-inline-start: var(--fs-spacing-1) solid var(--fs-color-accent-fill);
        color: var(--fs-color-neutral-text-subtle);
        font-size: var(--font-size-s);
      }
      .gallery :global(.gallery__said) {
        margin: 0 0 var(--fs-spacing-2);
        font-size: var(--font-size-xs);
        color: var(--fs-color-neutral-text-subtle);
      }
      .gallery :global(.gallery__wire) {
        color: var(--fs-color-accent-fill);
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      }
      .gallery :global(.gallery__chisel) {
        inline-size: 100%;
      }
      /*
       * The frame the server sent, wrapped. Without this the `pre` is one long line, the page
       * grows a horizontal scrollbar, and every section on it is dragged sideways with it.
       */
      .gallery__said-box :global(.wire__frame) {
        margin: 0;
        padding: var(--fs-spacing-3);
        background: var(--fs-color-neutral-surface);
        border-radius: var(--fs-spacing-1);
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: var(--font-size-xs);
        line-height: var(--fs-line-height-compact);
        white-space: pre-wrap;
        overflow-wrap: anywhere;
      }

      .muster {
        display: grid;
        gap: var(--fs-spacing-4);
        justify-items: start;
        max-inline-size: 26rem;
      }
      .muster__field {
        display: grid;
        gap: var(--fs-spacing-1);
        inline-size: 100%;
      }
      .muster__summary {
        margin-block-start: var(--fs-spacing-4);
      }
      .muster__summary :global(.fs-error-summary) {
        display: grid;
        gap: var(--fs-spacing-2);
      }
      .muster__summary :global(.muster__ok) {
        margin: 0;
        color: var(--fs-color-accent-fill);
      }

      .counter {
        display: grid;
        gap: var(--fs-spacing-3);
        justify-items: start;
      }
      .counter__face {
        inline-size: 100%;
        display: grid;
        gap: var(--fs-spacing-1);
      }
      .counter :global(.counter__number) {
        margin: 0;
        font-size: var(--font-size-xxl);
        font-weight: var(--font-weight-bold);
        line-height: 1;
        font-variant-numeric: tabular-nums;
        color: var(--fs-color-accent-fill);
      }
      .counter :global(.counter__state) {
        margin: 0;
        color: var(--fs-color-neutral-text-subtle);
      }

      .panel__json,
      .panel__body :global(.wire__frame) {
        margin: 0;
        padding: var(--fs-spacing-3);
        overflow-x: auto;
        background: var(--fs-color-neutral-surface);
        border-radius: var(--fs-spacing-1);
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: var(--font-size-xs);
        line-height: var(--fs-line-height-compact);
        white-space: pre-wrap;
      }
      .panel__body :global(.wire__frame + .wire__frame) {
        margin-block-start: var(--fs-spacing-2);
      }
      .panel__body :global(.hits) {
        margin: 0;
        padding: 0;
        list-style: none;
        display: grid;
        gap: var(--fs-spacing-3);
      }
      .panel__body :global(.hits__heading) {
        color: var(--fs-color-neutral-text-subtle);
      }
      .panel__body :global(.hits__excerpt) {
        margin: var(--fs-spacing-1) 0 0;
        color: var(--fs-color-neutral-text-subtle);
      }
    </style>
  </body>
</html>
