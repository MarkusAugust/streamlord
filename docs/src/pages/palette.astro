---
import "../styles/global.css"

// Temporary preview of the generated theme. It stays until the palette is
// settled, then it goes.

const scales = [
  {
    name: "interactive",
    title: "Interactive",
    steps: [5, 10, 30, 50, 70, 100],
  },
  { name: "danger", title: "Danger", steps: [5, 10, 30, 50, 70, 100] },
  { name: "success", title: "Success", steps: [5, 10, 30, 50, 70, 100] },
  { name: "warning", title: "Warning", steps: [5, 10, 30, 50, 70, 100] },
  { name: "visited", title: "Visited", steps: [5, 10, 30, 50, 70, 100] },
  { name: "neutral", title: "Neutral", steps: [0, 5, 10, 30, 50, 70, 100] },
]

const deckColors = [
  { name: "--flate", value: "#10161f" },
  { name: "--flate-kort", value: "#171f2b" },
  { name: "--tekst", value: "#f2f5f9" },
  { name: "--azure-70", value: "#1362ae" },
  { name: "--forest-100", value: "#2b6940" },
  { name: "--ochre-100", value: "#6b492c" },
  { name: "--burgundy-100", value: "#6f2c3f" },
]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Palette | Streamlord</title>
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <header class="top">
      <h1 class="fs-heading" data-size="m">Palette</h1>
      <div class="row" role="group" aria-label="Theme">
        <button class="fs-button" data-variant="secondary" data-set="light">Light</button>
        <button class="fs-button" data-variant="secondary" data-set="dark">Dark</button>
        <button class="fs-button" data-variant="ghost" data-set="system">System</button>
      </div>
    </header>

    <main class="page">
      <section>
        <h2 class="fs-heading" data-size="s">Generated scales</h2>
        {
          scales.map((scale) => (
            <div class="scale">
              <span class="scale__name">{scale.title}</span>
              <div class="scale__steps">
                {scale.steps.map((step) => (
                  <div
                    class="swatch"
                    style={`background:var(--palette-${scale.name}-${step})`}
                  >
                    <span>{step}</span>
                  </div>
                ))}
              </div>
            </div>
          ))
        }
      </section>

      <section>
        <h2 class="fs-heading" data-size="s">Buttons, links and badges</h2>
        <div class="row">
          <button class="fs-button">Primary</button>
          <button class="fs-button" data-variant="secondary">Secondary</button>
          <button class="fs-button" data-variant="ghost">Ghost</button>
          <button class="fs-button" data-variant="danger">Danger</button>
          <button class="fs-button" aria-disabled="true">Disabled</button>
        </div>
        <p class="fs-paragraph">
          A <a class="fs-link" href="#">link in running text</a> and an
          <a class="fs-link" href="https://data-star.dev">external one</a>.
        </p>
        <div class="row">
          <span class="fs-badge">New</span>
          <span class="fs-badge" data-color="success">Verified</span>
          <span class="fs-badge" data-color="warning">Draft</span>
          <span class="fs-badge" data-color="danger">Rejected</span>
          <span class="fs-badge" data-color="neutral">0.3.0</span>
        </div>
      </section>

      <section>
        <h2 class="fs-heading" data-size="s">Messages</h2>
        <div class="stack">
          <div class="fs-alert" data-color="info">
            Datastar 1.0 knows only two SSE events.
          </div>
          <div class="fs-alert" data-color="success">
            The encoder is verified against the official golden files.
          </div>
          <div class="fs-alert" data-color="warning">
            Every mode except <code>outer</code> and <code>replace</code> requires a selector.
          </div>
          <div class="fs-alert" data-color="danger">
            The signal was refused: the name contains a hyphen.
          </div>
        </div>
      </section>

      <section>
        <h2 class="fs-heading" data-size="s">Against the deck</h2>
        <div class="row">
          {
            deckColors.map((colour) => (
              <div class="sample">
                <div class="sample__face" style={`background:${colour.value}`} />
                <code>{colour.name}</code>
              </div>
            ))
          }
        </div>
      </section>
    </main>

    <style>
      .top,
      .page {
        max-width: 60rem;
        margin: 0 auto;
        padding-inline: var(--size-4);
      }
      .top {
        display: flex;
        flex-wrap: wrap;
        gap: var(--size-4);
        align-items: center;
        justify-content: space-between;
        padding-block-start: var(--size-6);
      }
      .page {
        display: grid;
        gap: var(--size-10);
        padding-block: var(--size-6) var(--size-16);
      }
      .row {
        display: flex;
        flex-wrap: wrap;
        gap: var(--size-3);
        align-items: center;
      }
      .stack {
        display: grid;
        gap: var(--size-3);
      }
      .scale {
        display: grid;
        grid-template-columns: 8rem 1fr;
        gap: var(--size-3);
        align-items: center;
        margin-block: var(--size-2);
      }
      .scale__name {
        font-size: var(--font-size-s);
        color: var(--semantic-muted-foreground);
      }
      .scale__steps {
        display: flex;
        gap: var(--size-1);
      }
      .swatch {
        flex: 1;
        aspect-ratio: 2 / 1;
        border-radius: var(--size-1);
        border: 1px solid var(--semantic-divider-30);
        display: grid;
        place-items: center;
      }
      .swatch span {
        background: var(--semantic-page-background);
        padding-inline: 0.25em;
        border-radius: 2px;
        font-size: var(--font-size-xxs);
        opacity: 0.75;
      }
      .sample {
        display: grid;
        gap: var(--size-1);
        justify-items: center;
      }
      .sample__face {
        inline-size: 5rem;
        block-size: 3rem;
        border-radius: var(--size-1);
        border: 1px solid var(--semantic-divider-30);
      }
      code {
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: var(--font-size-xxs);
      }
    </style>

    <script>
      const root = document.documentElement
      try {
        const saved = localStorage.getItem("theme")
        if (saved === "light" || saved === "dark") root.dataset.theme = saved
      } catch {}

      for (const button of document.querySelectorAll<HTMLButtonElement>("[data-set]")) {
        button.addEventListener("click", () => {
          const choice = button.dataset.set
          try {
            if (choice === "system") {
              delete root.dataset.theme
              localStorage.removeItem("theme")
            } else if (choice) {
              root.dataset.theme = choice
              localStorage.setItem("theme", choice)
            }
          } catch {}
        })
      }
    </script>
  </body>
</html>
