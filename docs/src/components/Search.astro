---
import { fs } from "@fristil/designsystem"
import { SERVICE } from "../config"
import { href, NAVIGATION } from "../navigation"

// Fristil's own classes for a search field, with ours appended rather than spread beside them.
//
// `{...fs.search()}` sets `class`, and the spread wins over a `class` written after it, so an
// input carrying both ended up with Fristil's two classes and not ours, silently. Every rule
// written for `.search__field` matched nothing until this was pulled apart.
const { class: fristilClasses, ...searchAttributes } = fs.search()

// The search in the masthead, on every page.
//
// It is the same endpoint the live page uses and the same markup comes back, so a reader
// searching the documentation is running the library that the documentation describes.
//
// The panel starts out holding every page, written at build time. That is the fallback: the
// service sleeps on a free tier and wakes in a second or two, and if it never wakes (or the
// reader is offline, or on a preview build with no service at all) the panel is a table of
// contents rather than an empty box. Datastar only replaces what it is given, so a request
// that never answers leaves the list exactly as it was.
---

<!--
  `datastar-fetch` is dispatched on the document and does not bubble, so the listener says
  __document, Datastar's own modifier for exactly this. With the service unreachable the type
  is `retrying`, not `error`: it retries a stream before it gives up. A request that succeeds
  ends on `finished`, which sets the signal back to false, so the line below comes and goes with
  the service rather than latching on the first hiccup.

  `wire` starts false and the panel at the foot of the article turns it on when it is opened. It
  is what asks the service to encode the frames it sent and patch them in, and the frames are
  2.4 times the size of the answer they describe, worth it for a reader who opened the panel to
  look at them, and pure waste on every search of every page for everyone else.
-->
<div
  class="search"
  role="search"
  data-signals="{query: '', searching: false, offline: false, wire: false}"
  data-on:datastar-fetch__document={"$offline = ['error', 'retrying', 'retries-failed'].includes(evt.detail.type)"}
>
  <label class="fs-sr-only" for="site-search">Search the documentation</label>
  <input
    {...searchAttributes}
    id="site-search"
    class={`${fristilClasses} search__field`}
    placeholder="Search"
    autocomplete="off"
    data-bind:query
    data-indicator:searching
    data-on:input__debounce.300ms={`@get('${SERVICE}/search')`}
    data-on:keydown={"evt.key === 'Escape' && ($query = '')"}
  />

  <!--
    Shown once there is something to search for, and never before: a panel that appears empty
    while the service wakes up reads as a broken page rather than a slow one.

    aria-live, because the server replaces these silently. Without it a reader using a screen
    reader types, an answer arrives, and nothing says so. aria-busy follows the indicator, so
    the announcement waits for the answer instead of reading a half-filled list.
  -->
  <div
    class="search__panel"
    data-show="$query"
    data-attr:aria-busy="$searching"
    aria-live="polite"
  >
    <!--
      Why the list below is not an answer to what was typed. Without it the panel holds either
      every page or the hits from a previous word, and both read as a search that got it wrong
      rather than a service that is asleep.
    -->
    <p class="search__offline" data-show="$offline">
      The search service is not answering.
    </p>

    <div id="results" class="search__results">
      <p class="search__all">Every page</p>
      <ul class="fs-list hits" data-variant="plain">
        {
          NAVIGATION.flatMap((section) =>
            section.pages.map((page) => (
              <li>
                <a class="fs-link hits__where" href={href(page.slug)}>
                  {page.title}
                  <span class="hits__heading"> · {section.title}</span>
                </a>
              </li>
            )),
          )
        }
      </ul>
    </div>
  </div>
</div>

<style>
  .search {
    position: relative;
    flex: 1 1 auto;
    max-inline-size: 22rem;
  }
  /*
   * The field lifts off the band it sits on, rather than carrying a colour of its own.
   *
   * The masthead is a data-theme="dark" island on both themes, so Fristil gave the input the
   * dark theme's surface, rgb(23, 26, 36). Against the dark band that is a gentle lift, but
   * the light theme's band is the deck's denim, rgb(44, 67, 107), and a near-black field on it
   * reads as a hole punched through the header.
   *
   * A translucent white does the same job on both: about rgb(36, 37, 43) over the dark band and
   * rgb(65, 86, 122) over the denim. The label stays near-white in both, so the text keeps its
   * contrast either way.
   */
  .search__field {
    inline-size: 100%;
    /* background-color, not background: the shorthand wipes the background-image Fristil uses
       to draw the magnifier, and the icon vanished without a word. */
    background-color: rgb(255 255 255 / 0.1);
    border-color: rgb(255 255 255 / 0.28);
    color: var(--semantic-page-foreground);
  }
  .search__field:hover {
    background-color: rgb(255 255 255 / 0.16);
  }
  /*
   * The label is there for a screen reader and hidden from the eye, so the placeholder is the
   * only visible name this field has. Fristil's muted grey measured 3.45:1 against the lifted
   * surface, fine for decoration, thin for the only thing that says what the box is for.
   */
  .search__field::placeholder {
    color: rgb(255 255 255 / 0.72);
  }
  .search__panel {
    position: absolute;
    /*
     * Wider than the field, hanging from its right edge: a hit is a page, a heading and a line
     * of the text it was found in, and at the width of the field that line wraps four times and
     * stops being a glance.
     */
    inset-inline-end: 0;
    /*
     * It hangs from the right edge of the field and grows leftwards, so its width is limited by
     * what is to the left of that edge, not by the window. At 32rem it reached 24px past the
     * left of a 645px window and cut the first letter off every hit. 28rem clears the narrowest
     * window that still gets this layout, and the viewport term catches the rest.
     */
    inline-size: min(28rem, calc(100vw - 4rem));
    inset-block-start: calc(100% + var(--size-2));
    z-index: 20;
    /*
     * The page's theme, taken back from the masthead's.
     *
     * The panel belongs to what you are reading, not to the furniture above it, but it is a
     * child of a data-theme="dark" island, so every semantic colour inside it, down to the link
     * colour Fristil gives .fs-link, was the dark theme's, and the panel arrived as a black box
     * over a white article. Re-declaring the six that the panel and its contents use, from the
     * page values captured on :root, hands the whole subtree back to the page.
     *
     * A fixed ceiling with its own scroll, because a panel that grows and shrinks with every
     * keystroke reads as a page coming apart.
     */
    --semantic-page-background: var(--page-background);
    --semantic-page-foreground: var(--page-foreground);
    --semantic-muted-foreground: var(--page-muted);
    --semantic-divider-30: var(--page-divider);
    --semantic-neutral-background: var(--page-neutral);
    --semantic-interactive-main: var(--page-interactive);
    --semantic-interactive-visited: var(--page-interactive-visited);
    color-scheme: var(--page-color-scheme);
    background: var(--semantic-page-background);
    color: var(--semantic-page-foreground);
    border: 1px solid var(--semantic-divider-30);
    border-radius: var(--size-1);
    box-shadow: 0 12px 32px rgb(0 0 0 / 0.35);
    max-block-size: min(60vh, 32rem);
    overflow-y: auto;
    padding: var(--size-3);
  }
  .search__offline {
    margin: 0 0 var(--size-2);
    padding: var(--size-2);
    border-radius: var(--size-1);
    background: var(--semantic-neutral-background);
    color: var(--semantic-muted-foreground);
    font-size: var(--font-size-xs);
  }
  .search__all {
    margin: 0 0 var(--size-2);
    font-size: var(--font-size-xxs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--semantic-muted-foreground);
  }

  /* The server writes these, so they are styled here rather than where they are built. */
  .search__results :global(.hits) {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--size-2);
  }
  .search__results :global(.hits__heading) {
    color: var(--semantic-muted-foreground);
    font-weight: var(--font-weight-regular);
  }
  .search__results :global(.hits__excerpt) {
    margin: var(--size-1) 0 0;
    color: var(--semantic-muted-foreground);
  }

  /*
   * On a phone the field takes a row of its own under the brand, and the panel spans it.
   * Three things on one row at 390px is a masthead nobody can hit with a thumb.
   */
  @media (max-width: 40rem) {
    .search {
      order: 3;
      flex-basis: 100%;
      max-inline-size: none;
    }
    /* Full width under a full-width field, and the screen is the only ceiling. */
    .search__panel {
      inline-size: auto;
      inset-inline: 0;
    }
  }
</style>
