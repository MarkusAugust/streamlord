---
import { href, neighbours } from "../navigation"

interface Props {
  current: string
}

const { previous, next } = neighbours(Astro.props.current)
---

{
  (previous || next) && (
    <nav class="pager" aria-label="Previous and next page">
      {previous ? (
        <a class="pager__link" href={href(previous.slug)} rel="prev">
          <span class="pager__direction">Previous</span>
          <span class="pager__title">{previous.title}</span>
        </a>
      ) : (
        <span />
      )}
      {next && (
        <a class="pager__link" data-next href={href(next.slug)} rel="next">
          <span class="pager__direction">Next</span>
          <span class="pager__title">{next.title}</span>
        </a>
      )}
    </nav>
  )
}

<style>
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--fs-spacing-3);
    margin-block-start: var(--fs-spacing-12);
    padding-block-start: var(--fs-spacing-6);
    border-block-start: 1px solid var(--fs-color-neutral-border-subtle);
  }
  .pager__link {
    display: grid;
    gap: var(--fs-spacing-1);
    padding: var(--fs-spacing-3) var(--fs-spacing-4);
    border: 1px solid var(--fs-color-neutral-border-subtle);
    border-radius: var(--fs-spacing-1);
    text-decoration: none;
    color: var(--fs-color-neutral-text-strong);
  }
  .pager__link[data-next] {
    text-align: end;
  }
  .pager__link:hover {
    border-color: var(--fs-color-accent-text);
  }
  .pager__link:focus-visible {
    outline: var(--fs-focus-ring);
    outline-offset: 2px;
  }
  .pager__direction {
    font-size: var(--font-size-xxs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--fs-color-neutral-text-subtle);
  }
  .pager__title {
    color: var(--fs-color-accent-text);
    font-weight: var(--font-weight-medium);
  }
</style>
