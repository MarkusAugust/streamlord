---
import type { MarkdownHeading } from "astro"
import CodeBlock from "../components/CodeBlock.astro"
import Logo from "../components/Logo.astro"
import Pager from "../components/Pager.astro"
import Search from "../components/Search.astro"
import Sidebar from "../components/Sidebar.astro"
import Toc from "../components/Toc.astro"
import Wire from "../components/Wire.astro"
import { FAVICON } from "../icon"
import "../styles/global.css"

interface Props {
  title: string
  description: string
  slug: string
  headings: MarkdownHeading[]
}

const { title, description, slug, headings } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Streamlord</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" href={FAVICON} type="image/svg+xml" />
    <!--
      Datastar, on every page, because the search in the masthead is on every page. It is the
      only script the documentation loads that is not its own, and it is the library this
      documentation is about: the search field is an attribute and a signal, and there is no
      code of ours between the keystroke and the server.
    -->
    <script
      type="module"
      src="https://cdn.jsdelivr.net/gh/starfederation/datastar@v1.0.4/bundles/datastar.js"
    ></script>

    <script is:inline>
      // Inline and before paint, so the page never flashes the wrong theme.
      // Datastar takes the toggle over; this one only restores the choice.
      try {
        const saved = localStorage.getItem("theme")
        if (saved === "light" || saved === "dark") {
          document.documentElement.dataset.theme = saved
        }
      } catch {}
    </script>
  </head>
  <body>
    <a class="fs-skip-link" href="#content">Skip to content</a>

    <header class="masthead" data-theme="dark">
      <a class="masthead__brand" href="/">
        <Logo size={26} />
        <span>Streamlord</span>
      </a>
      <!-- Between the mark and the tools, so a phone can drop it to a row of its own
           without pushing the theme button down with it. -->
      <Search />
      <div class="masthead__tools">
        <button class="fs-button" data-variant="ghost" data-theme-toggle>
          Theme
        </button>
      </div>
    </header>

    <div class="shell">
      <aside class="shell__sidebar">
        <Sidebar current={slug} />
      </aside>

      <main class="shell__main" id="content">
        <article class="prose">
          <h1 class="fs-heading" data-size="xl">{title}</h1>
          <p class="fs-paragraph" data-variant="lead">{description}</p>
          <slot />
        </article>
        <Wire />
        <Pager current={slug} />
      </main>

      <aside class="shell__toc">
        <Toc headings={headings} />
      </aside>
    </div>

    <CodeBlock />

    <script>
      import { defineFsTabs } from "@fristil/designsystem/tabs"

      // Once for the whole page, not once per tab set.
      defineFsTabs()

      /*
       * Tab sets follow each other. A reader who picks Maven on one block means Maven
       * everywhere, on this page and the next: the choice is about them, not about the
       * block. Kept in localStorage because it is a per-reader convenience and nothing
       * depends on it surviving.
       */
      const KEY = "tab-choice"
      let syncing = false

      const pick = (label: string) => {
        if (syncing) return
        syncing = true
        try {
          localStorage.setItem(KEY, label)
        } catch {}

        for (const button of document.querySelectorAll<HTMLButtonElement>("[data-tab-label]")) {
          if (button.dataset.tabLabel === label && button.getAttribute("aria-selected") !== "true") {
            button.click()
          }
        }
        syncing = false
      }

      document.addEventListener("click", (event) => {
        const button = (event.target as HTMLElement)?.closest<HTMLButtonElement>("[data-tab-label]")
        if (button?.dataset.tabLabel) pick(button.dataset.tabLabel)
      })

      try {
        const saved = localStorage.getItem(KEY)
        if (saved) pick(saved)
      } catch {}
    </script>

    <style>
      .masthead {
        /* Dark under both themes, because the mark was drawn on a dark ground and a header
           that changes colour under a logo that does not is worse than either. The island
           carries data-theme="dark" rather than hand-written colours, so the label, the
           button and its states all follow the tokens.

           Two grounds, though, because the page underneath is two pages. Over white, near-black is a
           ~19:1 edge (as hard as an edge gets) so the light theme takes #2c436b, the deck's
           own --denim-100, which roughly halves it to ~9.5:1. Over the dark page that softer
           band would be *lighter* than the surface and float forward, so the dark theme keeps
           #0c0d14: the ground the mark was drawn on, the same one the landing page uses, and
           at 1.12:1 against the surface it anchors the top while the border does the parting.

           The band is a data-theme="dark" island either way, so these two selectors key off
           the root's theme rather than its own. */
        background: #2c436b;
        color: var(--semantic-page-foreground);
        border-block-end: 1px solid rgba(0, 177, 250, 0.25);
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: var(--size-3) var(--size-4);
        padding: var(--size-3) var(--size-5);
      }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme="light"]) .masthead {
          background: #0c0d14;
        }
      }
      :root[data-theme="dark"] .masthead {
        background: #0c0d14;
      }

      /*
       * The ghost button fills on hover instead of tinting.
       *
       * Its own hover is --semantic-interactive-background, which in the dark theme is
       * #004869, measured at 1.00:1 against this band, the same luminance, so the hover was
       * invisible. Brightening the background alone does not help: the label is #88d1ff, and
       * the lighter steps of the scale converge with it (#00b1fa leaves the text at 1.45:1).
       * Swapping both is what works: step 30 behind step 100 is 5.92:1 for the label and
       * 5.94:1 against the band, so the state is unmistakable from either direction.
       */
      .masthead .fs-button[data-variant="ghost"]:hover {
        background: var(--palette-interactive-30);
        color: var(--palette-interactive-100);
      }

      .masthead__brand {
        display: flex;
        align-items: center;
        gap: var(--size-2);
        font-weight: var(--font-weight-bold);
        font-size: var(--font-size-l);
        color: var(--semantic-page-foreground);
        text-decoration: none;
        letter-spacing: -0.01em;
      }
      .masthead__tools {
        display: flex;
        gap: var(--size-2) var(--size-3);
        align-items: center;
      }

      .shell {
        display: grid;
        grid-template-columns: 16rem minmax(0, 1fr) 14rem;
        gap: var(--size-8);
        max-width: 84rem;
        margin: 0 auto;
        padding: var(--size-6) var(--size-5) var(--size-16);
      }
      .shell__sidebar {
        align-self: start;
        position: sticky;
        top: var(--size-6);
      }
      .shell__main {
        min-width: 0;
      }

      @media (max-width: 75rem) {
        .shell {
          grid-template-columns: 16rem minmax(0, 1fr);
        }
      }
      @media (max-width: 60rem) {
        .shell {
          grid-template-columns: minmax(0, 1fr);
          gap: var(--size-5);
          padding-inline: var(--size-4);
        }
        .shell__sidebar {
          position: static;
        }
      }
    </style>

    <style is:global>
      .prose h1 {
        margin-block-end: var(--size-2);
      }
      .prose h2 {
        margin-block-start: var(--size-8);
        font-size: var(--font-size-l);
        line-height: var(--semantic-line-height-heading);
      }
      .prose h3 {
        margin-block-start: var(--size-6);
        font-size: var(--font-size-m);
      }
      .prose p,
      .prose li {
        line-height: var(--semantic-line-height-article);
      }
      .prose a {
        color: var(--semantic-interactive-main);
      }
      .prose table {
        width: 100%;
        border-collapse: collapse;
      }

      /*
       * The epigraph that opens seven of these pages, given the same blue edge the creed has
       * on the landing page, so the voice looks like one voice wherever it speaks.
       *
       * The landing page damps the edge to 35% because it sits on #0c0d14, the deep ground
       * the mark was drawn on. These pages follow the reader, and their dark surface is
       * #171a24, which is lighter: the same 35% measured invisible against it. So the colour
       * is the token in both themes and only the strength moves, enough on dark to read as a
       * deliberate rule rather than a rendering artefact.
       */
      .prose blockquote {
        margin: var(--size-6) 0;
        padding-inline-start: var(--size-4);
        border-inline-start: 2px solid var(--palette-interactive-50);
        color: var(--semantic-muted-foreground);
      }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme="light"]) .prose blockquote {
          border-inline-start-color: rgba(0, 177, 250, 0.7);
        }
      }
      :root[data-theme="dark"] .prose blockquote {
        border-inline-start-color: rgba(0, 177, 250, 0.7);
      }
    </style>

    <script>
      /*
       * Flips what the reader is actually looking at.
       *
       * The first version cycled dark, light, system and read the attribute rather than the
       * result. With the system set to dark and nothing chosen yet, the attribute is unset,
       * so the first press wrote data-theme="dark" and changed nothing anyone could see. Two
       * presses to leave dark, one to leave light. Reading the effective theme removes the
       * dead press, at the cost of "follow the system" being a default rather than a state
       * to cycle back into, which is the right trade for a button with one label.
       */
      const root = document.documentElement
      const button = document.querySelector("[data-theme-toggle]")
      const systemDark = window.matchMedia("(prefers-color-scheme: dark)")

      const shown = () => root.dataset.theme ?? (systemDark.matches ? "dark" : "light")

      const describe = () => {
        const next = shown() === "dark" ? "light" : "dark"
        button?.setAttribute("aria-label", `Switch to the ${next} theme`)
      }

      button?.addEventListener("click", () => {
        const next = shown() === "dark" ? "light" : "dark"
        root.dataset.theme = next
        try {
          localStorage.setItem("theme", next)
        } catch {}
        describe()
      })

      systemDark.addEventListener("change", describe)
      describe()
    </script>
  </body>
</html>
