---
import type { MarkdownHeading } from "astro"
import CodeBlock from "../components/CodeBlock.astro"
import Logo from "../components/Logo.astro"
import Pager from "../components/Pager.astro"
import Search from "../components/Search.astro"
import Sidebar from "../components/Sidebar.astro"
import ThemeRestore from "../components/ThemeRestore.astro"
import ThemeToggle from "../components/ThemeToggle.astro"
import Toc from "../components/Toc.astro"
import Wire from "../components/Wire.astro"
import { FAVICON } from "../icon"
import "../styles/global.css"

interface Props {
  title: string
  description: string
  slug: string
  headings: MarkdownHeading[]
}

const { title, description, slug, headings } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Streamlord</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" href={FAVICON} type="image/svg+xml" />
    <!--
      Datastar, on every page, because the search in the masthead is on every page. It is the
      only script the documentation loads that is not its own, and it is the library this
      documentation is about: the search field is an attribute and a signal, and there is no
      code of ours between the keystroke and the server.
    -->
    <script
      type="module"
      src="https://cdn.jsdelivr.net/gh/starfederation/datastar@v1.0.4/bundles/datastar.js"
    ></script>

    <ThemeRestore />
  </head>
  <body>
    <a class="fs-skip-link" href="#content">Skip to content</a>

    <header class="masthead" data-theme="dark">
      <a class="masthead__brand" href="/">
        <Logo size={26} />
        <span>Streamlord</span>
      </a>
      <!-- Between the mark and the tools, so a phone can drop it to a row of its own
           without pushing the theme button down with it. -->
      <Search />
      <div class="masthead__tools">
        <ThemeToggle />
      </div>
    </header>

    <div class="shell">
      <aside class="shell__sidebar">
        <Sidebar current={slug} />
      </aside>

      <main class="shell__main" id="content">
        <article class="prose">
          <h1 class="fs-heading" data-size="xl">{title}</h1>
          <p class="fs-paragraph" data-variant="lead">{description}</p>
          <slot />
        </article>
        <Wire />
        <Pager current={slug} />
      </main>

      <aside class="shell__toc">
        <Toc headings={headings} />
      </aside>
    </div>

    <CodeBlock />

    <script>
      import { defineFsTabs } from "@fristil/designsystem/tabs"

      // Once for the whole page, not once per tab set.
      defineFsTabs()

      /*
       * Tab sets follow each other. A reader who picks Maven on one block means Maven
       * everywhere, on this page and the next: the choice is about them, not about the
       * block. Kept in localStorage because it is a per-reader convenience and nothing
       * depends on it surviving.
       */
      const KEY = "tab-choice"
      let syncing = false

      const pick = (label: string) => {
        if (syncing) return
        syncing = true
        try {
          localStorage.setItem(KEY, label)
        } catch {}

        for (const button of document.querySelectorAll<HTMLButtonElement>("[data-tab-label]")) {
          if (button.dataset.tabLabel === label && button.getAttribute("aria-selected") !== "true") {
            button.click()
          }
        }
        syncing = false
      }

      document.addEventListener("click", (event) => {
        const button = (event.target as HTMLElement)?.closest<HTMLButtonElement>("[data-tab-label]")
        if (button?.dataset.tabLabel) pick(button.dataset.tabLabel)
      })

      try {
        const saved = localStorage.getItem(KEY)
        if (saved) pick(saved)
      } catch {}
    </script>

    <style>
      .masthead {
        /* Dark under both themes, because the mark was drawn on a dark ground and a header
           that changes colour under a logo that does not is worse than either. The island
           carries data-theme="dark" rather than hand-written colours, so the label, the
           button and its states all follow the tokens.

           Two grounds, though, because the page underneath is two pages. Over white, near-black is a
           ~19:1 edge (as hard as an edge gets) so the light theme takes #2c436b, the deck's
           own --denim-100, which roughly halves it to ~9.5:1. Over the dark page that softer
           band would be *lighter* than the surface and float forward, so the dark theme keeps
           #0c0d14: the ground the mark was drawn on, the same one the landing page uses, and
           at 1.12:1 against the surface it anchors the top while the border does the parting.

           The band is a data-theme="dark" island either way, so these two selectors key off
           the root's theme rather than its own. */
        background: #2c436b;
        color: var(--fs-color-neutral-text-strong);
        border-block-end: 1px solid color-mix(in oklab, var(--fs-color-accent-fill) 25%, transparent);
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: var(--fs-spacing-3) var(--fs-spacing-4);
        padding: var(--fs-spacing-3) var(--fs-spacing-5);
      }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme="light"]) .masthead {
          background: #0c0d14;
        }
      }
      :root[data-theme="dark"] .masthead {
        background: #0c0d14;
      }

      /*
       * The ghost button fills on hover instead of tinting.
       *
       * Its own hover is accent-surface, which inside this always-dark island is #122733 and
       * sits within a hair of the band's own luminance, so the hover was invisible. The two
       * roles are swapped instead: accent-text is the lightest accent the dark theme has, and
       * accent-surface is what reads on top of it. That measures 8.94:1 for the label and
       * 5.74:1 against the lighter of the two bands, so the state carries from either
       * direction. Off-contract on purpose, since a light fill inside a dark island is not a
       * pairing the matrix makes promises about.
       */
      .masthead .fs-button[data-variant="ghost"]:hover {
        background: var(--fs-color-accent-text);
        color: var(--fs-color-accent-surface);
      }

      .masthead__brand {
        display: flex;
        align-items: center;
        gap: var(--fs-spacing-2);
        font-weight: var(--font-weight-bold);
        font-size: var(--font-size-l);
        color: var(--fs-color-neutral-text-strong);
        text-decoration: none;
        letter-spacing: -0.01em;
      }
      .masthead__tools {
        display: flex;
        gap: var(--fs-spacing-2) var(--fs-spacing-3);
        align-items: center;
      }

      .shell {
        display: grid;
        grid-template-columns: 16rem minmax(0, 1fr) 14rem;
        gap: var(--fs-spacing-8);
        max-width: 84rem;
        margin: 0 auto;
        padding: var(--fs-spacing-6) var(--fs-spacing-5) var(--fs-spacing-16);
      }
      .shell__sidebar {
        align-self: start;
        position: sticky;
        top: var(--fs-spacing-6);
      }
      .shell__main {
        min-width: 0;
      }

      @media (max-width: 75rem) {
        .shell {
          grid-template-columns: 16rem minmax(0, 1fr);
        }
      }
      @media (max-width: 60rem) {
        .shell {
          grid-template-columns: minmax(0, 1fr);
          gap: var(--fs-spacing-5);
          padding-inline: var(--fs-spacing-4);
        }
        .shell__sidebar {
          position: static;
        }
      }
    </style>

    <style is:global>
      .prose h1 {
        margin-block-end: var(--fs-spacing-2);
      }
      .prose h2 {
        margin-block-start: var(--fs-spacing-8);
        font-size: var(--font-size-l);
        line-height: var(--fs-line-height-heading);
      }
      .prose h3 {
        margin-block-start: var(--fs-spacing-6);
        font-size: var(--font-size-m);
      }
      .prose p,
      .prose li {
        line-height: var(--fs-line-height-article);
      }
      .prose a {
        color: var(--fs-color-accent-text);
      }
      .prose table {
        width: 100%;
        border-collapse: collapse;
      }

      /*
       * The epigraph that opens seven of these pages, given the same blue edge the creed has
       * on the landing page, so the voice looks like one voice wherever it speaks.
       *
       * The colour is the token in both themes and only the strength moves. On dark the edge
       * is damped to 70%, because at the 35% the landing page uses it measures 1.73:1 against
       * the ground and reads as a rendering artefact rather than a deliberate rule.
       */
      .prose blockquote {
        margin: var(--fs-spacing-6) 0;
        padding-inline-start: var(--fs-spacing-4);
        border-inline-start: 2px solid var(--fs-color-accent-fill);
        color: var(--fs-color-neutral-text-subtle);
      }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme="light"]) .prose blockquote {
          border-inline-start-color: color-mix(in oklab, var(--fs-color-accent-fill) 70%, transparent);
        }
      }
      :root[data-theme="dark"] .prose blockquote {
        border-inline-start-color: color-mix(in oklab, var(--fs-color-accent-fill) 70%, transparent);
      }
    </style>

  </body>
</html>
