<idea-plugin>
    <id>io.github.markusaugust.streamlord</id>
    <name>Streamlord</name>
    <vendor url="https://github.com/MarkusAugust/streamlord">August Søberg-Klyver</vendor>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lang</depends>
    <depends>com.intellij.modules.xml</depends>
    <depends>org.jetbrains.kotlin</depends>
    <!-- Which of Streamlord's modules a project has, by JavaLibraryUtil; the Kotlin plugin needs Java already. -->
    <depends>com.intellij.java</depends>
    <depends optional="true" config-file="streamlord-json.xml">com.intellij.modules.json</depends>
    <depends optional="true" config-file="streamlord-spellchecker.xml">com.intellij.modules.spellchecker</depends>

    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <!-- K2 only: supportsK1 defaults to true, so a 2026.1 with K1 turned on would load the plugin without it. -->
        <supportsKotlinPluginMode supportsK1="false" supportsK2="true" />
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <completion.contributor
            language="kotlin"
            order="first, before KotlinCompletionContributor"
            implementationClass="io.github.markusaugust.streamlord.intellij.completion.StreamlordCompletionContributor" />
        <completion.contributor
            language="HTML"
            order="first"
            implementationClass="io.github.markusaugust.streamlord.intellij.completion.StreamlordCompletionContributor" />
        <completion.contributor
            language="TEXT"
            order="first"
            implementationClass="io.github.markusaugust.streamlord.intellij.completion.StreamlordCompletionContributor" />
        <typedHandler order="first" implementation="io.github.markusaugust.streamlord.intellij.completion.DatastarTypedHandler" />
        <completion.confidence
            language="kotlin"
            order="first"
            implementationClass="io.github.markusaugust.streamlord.intellij.completion.DatastarCompletionConfidence" />
        <completion.confidence
            language="HTML"
            order="first"
            implementationClass="io.github.markusaugust.streamlord.intellij.completion.DatastarCompletionConfidence" />
        <completion.confidence
            language="TEXT"
            order="first"
            implementationClass="io.github.markusaugust.streamlord.intellij.completion.DatastarCompletionConfidence" />

        <!-- XML covers HTML, which builds on it; first, so the tag's own parameter info does not answer inside a value. -->
        <codeInsight.parameterInfo
            language="XML"
            order="first"
            implementationClass="io.github.markusaugust.streamlord.intellij.completion.DatastarParameterInfoHandler" />
        <codeInsight.parameterInfo
            language="kotlin"
            order="first"
            implementationClass="io.github.markusaugust.streamlord.intellij.completion.DatastarParameterInfoHandler" />
        <codeInsight.parameterInfo
            language="TEXT"
            implementationClass="io.github.markusaugust.streamlord.intellij.completion.DatastarParameterInfoHandler" />

        <platform.backend.documentation.targetProvider
            implementation="io.github.markusaugust.streamlord.intellij.documentation.StreamlordDocumentationTargetProvider" />
        <platform.backend.documentation.lookupElementTargetProvider
            implementation="io.github.markusaugust.streamlord.intellij.documentation.StreamlordLookupDocumentationTargetProvider" />

        <annotator language="HTML" implementationClass="io.github.markusaugust.streamlord.intellij.highlighting.HtmlDatastarAnnotator" />
        <annotator language="kotlin" implementationClass="io.github.markusaugust.streamlord.intellij.highlighting.KotlinDatastarAnnotator" />
        <annotator language="TEXT" implementationClass="io.github.markusaugust.streamlord.intellij.highlighting.TemplateTextAnnotator" />
        <annotator language="textmate" implementationClass="io.github.markusaugust.streamlord.intellij.highlighting.TemplateTextAnnotator" />
        <colorSettingsPage implementation="io.github.markusaugust.streamlord.intellij.highlighting.DatastarColorSettingsPage" />
        <lang.inspectionSuppressor
            language="HTML"
            implementationClass="io.github.markusaugust.streamlord.intellij.inspections.DatastarNamespaceSuppressor" />

        <multiHostInjector implementation="io.github.markusaugust.streamlord.intellij.injection.HtmlStringInjector" />
        <psi.referenceContributor
            language="kotlin"
            implementation="io.github.markusaugust.streamlord.intellij.navigation.SignalReferenceContributor" />
        <psi.referenceContributor
            language="XML"
            implementation="io.github.markusaugust.streamlord.intellij.navigation.SignalReferenceContributor" />
        <!-- A template IntelliJ reads as plain text, and a read the official Datastar plugin also resolves. -->
        <gotoDeclarationHandler implementation="io.github.markusaugust.streamlord.intellij.navigation.SignalGotoDeclarationHandler" />
        <usageTargetProvider implementation="io.github.markusaugust.streamlord.intellij.navigation.SignalUsageTargetProvider" />
        <referencesSearch implementation="io.github.markusaugust.streamlord.intellij.navigation.SignalReferencesSearcher" />
        <findUsagesHandlerFactory implementation="io.github.markusaugust.streamlord.intellij.navigation.SignalFindUsagesHandlerFactory" />
        <renameHandler implementation="io.github.markusaugust.streamlord.intellij.navigation.SignalRenameHandler" />
        <renamePsiElementProcessor implementation="io.github.markusaugust.streamlord.intellij.navigation.SignalRenameProcessor" />
        <!-- The Kotlin contexts, in a module with the Streamlord modules a template needs. -->
        <liveTemplateContext
            contextId="STREAMLORD_CORE_STATEMENT"
            baseContextId="KOTLIN"
            implementation="io.github.markusaugust.streamlord.intellij.templates.StreamlordCoreStatementContextType" />
        <liveTemplateContext
            contextId="STREAMLORD_CORE_EXPRESSION"
            baseContextId="KOTLIN"
            implementation="io.github.markusaugust.streamlord.intellij.templates.StreamlordCoreExpressionContextType" />
        <liveTemplateContext
            contextId="STREAMLORD_HTML_STATEMENT"
            baseContextId="KOTLIN"
            implementation="io.github.markusaugust.streamlord.intellij.templates.StreamlordHtmlStatementContextType" />
        <liveTemplateContext
            contextId="STREAMLORD_HTML_EXPRESSION"
            baseContextId="KOTLIN"
            implementation="io.github.markusaugust.streamlord.intellij.templates.StreamlordHtmlExpressionContextType" />
        <liveTemplateContext
            contextId="STREAMLORD_KTOR_STATEMENT"
            baseContextId="KOTLIN"
            implementation="io.github.markusaugust.streamlord.intellij.templates.StreamlordKtorStatementContextType" />
        <liveTemplateContext
            contextId="STREAMLORD_KTOR_EXPRESSION"
            baseContextId="KOTLIN"
            implementation="io.github.markusaugust.streamlord.intellij.templates.StreamlordKtorExpressionContextType" />
        <liveTemplateContext
            contextId="STREAMLORD_KTOR_HTML_STATEMENT"
            baseContextId="KOTLIN"
            implementation="io.github.markusaugust.streamlord.intellij.templates.StreamlordKtorHtmlStatementContextType" />
        <liveTemplateContext
            contextId="STREAMLORD_KTOR_HTML_EXPRESSION"
            baseContextId="KOTLIN"
            implementation="io.github.markusaugust.streamlord.intellij.templates.StreamlordKtorHtmlExpressionContextType" />
        <liveTemplateContext
            contextId="STREAMLORD_SPRING_CLASS"
            baseContextId="KOTLIN"
            implementation="io.github.markusaugust.streamlord.intellij.templates.StreamlordSpringClassContextType" />
        <liveTemplateContext
            contextId="STREAMLORD_SPRING_TOPLEVEL"
            baseContextId="KOTLIN"
            implementation="io.github.markusaugust.streamlord.intellij.templates.StreamlordSpringTopLevelContextType" />
        <defaultLiveTemplates file="/liveTemplates/Streamlord.xml" />
        <defaultLiveTemplates file="/liveTemplates/StreamlordHtml.xml" />
        <notificationGroup id="Streamlord" displayType="BALLOON" />

        <toolWindow
            id="Streamlord"
            anchor="right"
            icon="AllIcons.Actions.Lightning"
            factoryClass="io.github.markusaugust.streamlord.intellij.inspector.InspectorToolWindowFactory" />
        <codeInsight.lineMarkerProvider
            language="kotlin"
            implementationClass="io.github.markusaugust.streamlord.intellij.inspector.RouteLineMarkerProvider" />
    </extensions>

    <actions>
        <group id="Streamlord.Tools" text="Streamlord" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last" />
            <action
                id="Streamlord.OpenInspector"
                class="io.github.markusaugust.streamlord.intellij.inspector.OpenInspectorAction"
                text="Open Stream Inspector"
                description="Connect to a running Datastar endpoint and watch the events arrive, decoded" />
            <action
                id="Streamlord.ReindexSignals"
                class="io.github.markusaugust.streamlord.intellij.actions.ReindexSignalsAction"
                text="Re-index Signals"
                description="Read every Kotlin and HTML file again for signal names, ids and classes" />
        </group>
    </actions>
    <projectListeners>
        <!-- Every process the project starts, so the inspector learns where a server listens from its own log. -->
        <listener
            class="io.github.markusaugust.streamlord.intellij.inspector.RunningServersListener"
            topic="com.intellij.execution.ExecutionListener" />
    </projectListeners>
    <extensions defaultExtensionNs="com.intellij">
        <projectConfigurable
            parentId="tools"
            instance="io.github.markusaugust.streamlord.intellij.settings.StreamlordConfigurable"
            id="io.github.markusaugust.streamlord.settings"
            displayName="Streamlord" />

        <localInspection
            shortName="KotlinInterpolationInspection"
            displayName="Kotlin value in a Datastar expression or HTML string"
            groupName="Streamlord"
            enabledByDefault="true"
            level="ERROR"
            implementationClass="io.github.markusaugust.streamlord.intellij.inspections.KotlinInterpolationInspection" />
        <localInspection
            shortName="DatastarExpressionInspection"
            displayName="Datastar expression"
            groupName="Streamlord"
            enabledByDefault="true"
            level="ERROR"
            implementationClass="io.github.markusaugust.streamlord.intellij.inspections.DatastarExpressionInspection" />
        <localInspection
            shortName="DatastarAttributeInspection"
            displayName="Datastar attribute"
            groupName="Streamlord"
            enabledByDefault="true"
            level="WARNING"
            implementationClass="io.github.markusaugust.streamlord.intellij.inspections.DatastarAttributeInspection" />
        <localInspection
            shortName="UnknownSignalInspection"
            displayName="Signal no file defines"
            groupName="Streamlord"
            enabledByDefault="true"
            level="WARNING"
            implementationClass="io.github.markusaugust.streamlord.intellij.inspections.UnknownSignalInspection" />
        <localInspection
            shortName="DatastarKeyCaseInspection"
            displayName="Datastar key casing"
            groupName="Streamlord"
            enabledByDefault="true"
            level="WARNING"
            implementationClass="io.github.markusaugust.streamlord.intellij.inspections.DatastarKeyCaseInspection" />
        <localInspection
            shortName="StreamlordMarkupInspection"
            displayName="Streamlord patch markup"
            groupName="Streamlord"
            enabledByDefault="true"
            level="WARNING"
            implementationClass="io.github.markusaugust.streamlord.intellij.inspections.StreamlordMarkupInspection" />

        <intentionAction>
            <language>kotlin</language>
            <className>io.github.markusaugust.streamlord.intellij.inspections.InterpolateIntention</className>
            <category>Streamlord</category>
        </intentionAction>
    </extensions>
</idea-plugin>
