{
  "name": "streamlord",
  "displayName": "Streamlord",
  "description": "Datastar tooling for the Streamlord Kotlin SDK: expression and markup diagnostics, completions, hover docs, and a live SSE stream inspector.",
  "version": "0.3.3",
  "publisher": "MarkusAugust",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/MarkusAugust/streamlord",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.105.0",
    "node": ">=22"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Other"
  ],
  "keywords": [
    "datastar",
    "kotlin",
    "ktor",
    "spring",
    "sse",
    "hypermedia"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "streamlord.inspector.open",
        "title": "Streamlord: Open Stream Inspector",
        "category": "Streamlord"
      },
      {
        "command": "streamlord.reindexSignals",
        "title": "Streamlord: Re-index signals",
        "category": "Streamlord"
      },
      {
        "command": "streamlord.colors.apply",
        "title": "Streamlord: Apply recommended colors",
        "category": "Streamlord"
      },
      {
        "command": "streamlord.colors.remove",
        "title": "Streamlord: Remove recommended colors",
        "category": "Streamlord"
      },
      {
        "command": "streamlord.inspector.openWith",
        "title": "Streamlord: Open Stream Inspector with route",
        "category": "Streamlord"
      }
    ],
    "configuration": {
      "title": "Streamlord",
      "properties": {
        "streamlord.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Validate Datastar expressions and markup in Kotlin strings and HTML files."
        },
        "streamlord.diagnostics.html": {
          "type": "boolean",
          "default": true,
          "description": "Also validate data-* attributes in .html files (templates)."
        },
        "streamlord.attributePrefix": {
          "type": "string",
          "default": "data-",
          "enum": [
            "data-",
            "data-star-"
          ],
          "description": "The attribute prefix of the Datastar bundle you load."
        },
        "streamlord.inspector.defaultUrl": {
          "type": "string",
          "default": "http://localhost:8080/",
          "description": "Default value of the {{baseUrl}} variable when neither settings nor .streamlord/env.json define it."
        },
        "streamlord.inspector.variables": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "Variables for {{name}} placeholders in inspector requests. .streamlord/env.json in the workspace overrides these."
        },
        "streamlord.inspector.requestsFile": {
          "type": "string",
          "default": ".streamlord/inspector.json",
          "description": "Workspace-relative file holding saved inspector requests."
        },
        "streamlord.inspector.codeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show “Open in Stream Inspector” above Ktor and Spring routes."
        },
        "streamlord.languages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "html",
            "jte",
            "kte",
            "ftl",
            "velocity",
            "mustache",
            "pebble",
            "twig",
            "jinja",
            "jinja-html",
            "django-html",
            "razor",
            "php",
            "blade",
            "erb",
            "handlebars",
            "ejs",
            "liquid",
            "nunjucks",
            "edge",
            "astro",
            "svelte",
            "vue",
            "gotemplate"
          ],
          "description": "Language ids that get Datastar attribute diagnostics, completion and hover on the HTML side: HTML itself (which is what Thymeleaf files are), JTE/kte, FreeMarker (ftl), Velocity, Mustache, Pebble and the rest. Kotlin is always included. Reload the window after changing."
        }
      }
    },
    "grammars": [
      {
        "language": "datastar-expression",
        "scopeName": "source.datastar",
        "path": "./syntaxes/datastar-expression.tmLanguage.json"
      },
      {
        "scopeName": "streamlord.kotlin.injection",
        "path": "./syntaxes/kotlin-injection.tmLanguage.json",
        "injectTo": [
          "source.kotlin"
        ],
        "embeddedLanguages": {
          "meta.embedded.inline.datastar": "datastar-expression",
          "meta.embedded.block.html": "html",
          "meta.embedded.block.javascript": "javascript"
        }
      },
      {
        "scopeName": "streamlord.html.injection",
        "path": "./syntaxes/html-injection.tmLanguage.json",
        "injectTo": [
          "text.html.basic",
          "text.html.derivative",
          "source.kotlin"
        ],
        "embeddedLanguages": {
          "meta.embedded.inline.datastar": "datastar-expression"
        }
      }
    ],
    "languages": [
      {
        "id": "datastar-expression",
        "aliases": [
          "Datastar expression"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": ".streamlord/inspector.json",
        "url": "./schemas/inspector.schema.json"
      }
    ],
    "html": {
      "customData": [
        "./html-customdata.json"
      ]
    },
    "snippets": [
      {
        "language": "kotlin",
        "path": "./snippets/kotlin.json"
      },
      {
        "language": "html",
        "path": "./snippets/html.json"
      }
    ]
  },
  "scripts": {
    "build": "node scripts/generate.mjs && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-transform-types --import ./test/hooks.mjs --test 'test/**/*.test.ts'",
    "package": "npm run typecheck && npm run build && vsce package --no-dependencies",
    "vscode:prepublish": "npm run build",
    "test:live": "node --experimental-transform-types --import ./test/hooks.mjs --test test/live/*.live.ts",
    "generate": "node scripts/generate.mjs"
  },
  "dependencies": {
    "acorn": "8.18.0"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "@types/vscode": "1.105.0",
    "@vscode/vsce": "3.6.2",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0c0d14",
    "theme": "dark"
  },
  "pricing": "Free",
  "homepage": "https://github.com/MarkusAugust/streamlord/tree/master/editors/vscode",
  "bugs": {
    "url": "https://github.com/MarkusAugust/streamlord/issues"
  }
}
