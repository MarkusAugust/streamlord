{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Datastar expression",
  "scopeName": "source.datastar",
  "patterns": [
    {
      "include": "#expression"
    }
  ],
  "repository": {
    "expression": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#entity-strings"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#regex"
        },
        {
          "include": "#signal"
        },
        {
          "include": "#action"
        },
        {
          "include": "#action-other"
        },
        {
          "include": "#scope-vars"
        },
        {
          "include": "#globals"
        },
        {
          "include": "#constants"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#option-keys"
        },
        {
          "include": "#object-key"
        },
        {
          "include": "#spread"
        },
        {
          "include": "#method-call"
        },
        {
          "include": "#property"
        },
        {
          "include": "#function-call"
        },
        {
          "include": "#duration"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#arrow"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#punctuation"
        },
        {
          "include": "#identifier"
        }
      ]
    },
    "signal": {
      "comment": "The client's signal, $(\\w+(?:[.-]\\w+)*). In a Kotlin string the dollar may be written \\$ or ${'$'}.",
      "match": "(?:(\\\\)(?=\\$)|(\\$\\{'\\$'\\}))?(\\$)?(?<=\\$|\\$'\\})(\\w+(?:-\\w+)*)((?:\\.\\w+(?:-\\w+)*)*)",
      "captures": {
        "1": {
          "name": "constant.character.escape.kotlin"
        },
        "2": {
          "name": "constant.character.escape.dollar.kotlin"
        },
        "3": {
          "name": "variable.other.constant.signal.datastar punctuation.definition.signal.datastar"
        },
        "4": {
          "name": "variable.other.constant.signal.datastar"
        },
        "5": {
          "name": "variable.other.property.signal-path.datastar"
        }
      }
    },
    "action": {
      "match": "(@)(get|post|put|patch|delete|query)(?=\\s*\\()",
      "captures": {
        "1": {
          "name": "entity.name.function.action.backend.datastar punctuation.definition.action.datastar"
        },
        "2": {
          "name": "entity.name.function.action.backend.datastar"
        }
      }
    },
    "action-other": {
      "match": "(@)([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
      "captures": {
        "1": {
          "name": "entity.name.function.action.datastar punctuation.definition.action.datastar"
        },
        "2": {
          "name": "entity.name.function.action.datastar"
        }
      }
    },
    "scope-vars": {
      "match": "(?<![.$])\\b(el|evt|patch)\\b(?!\\s*:(?!:))",
      "name": "variable.language.scope.datastar"
    },
    "globals": {
      "match": "(?<![.$])\\b(window|document|console|Math|JSON|Date|Intl|navigator|location|history|localStorage|sessionStorage|fetch|setTimeout|setInterval|clearTimeout|clearInterval|Promise|Array|Object|String|Number|Boolean)\\b",
      "name": "support.class.global.datastar"
    },
    "constants": {
      "match": "(?<![.$])\\b(true|false|null|undefined|NaN|Infinity)\\b",
      "name": "constant.language.datastar"
    },
    "option-keys": {
      "comment": "Keys of the fetch-action options object and signal filters, where an object's key stands: after { or a comma.",
      "match": "(?:(?<=[{,])|^)(\\s*)\\b(contentType|filterSignals|selector|headers|openWhenHidden|payload|requestCancellation|retry|retryInterval|retryScaler|retryMaxWait|retryMaxCount|include|exclude)\\b(?=\\s*:(?!:))",
      "captures": {
        "2": {
          "name": "support.type.property-name.option.datastar"
        }
      }
    },
    "object-key": {
      "match": "(?:(?<=[{,])|^)(\\s*)([A-Za-z_$][A-Za-z0-9_$]*)(?=\\s*:(?!:))",
      "captures": {
        "2": {
          "name": "variable.other.property.key.datastar"
        }
      }
    },
    "method-call": {
      "match": "(\\.)([A-Za-z_$][A-Za-z0-9_$]*)(?=\\s*\\()",
      "captures": {
        "1": {
          "name": "punctuation.accessor.datastar"
        },
        "2": {
          "name": "entity.name.function.method.datastar"
        }
      }
    },
    "property": {
      "match": "(\\.)([A-Za-z_$][A-Za-z0-9_$]*)",
      "captures": {
        "1": {
          "name": "punctuation.accessor.datastar"
        },
        "2": {
          "name": "variable.other.property.datastar"
        }
      }
    },
    "duration": {
      "match": "(?<![\\w$.])\\d+(?:ms|s)\\b",
      "name": "constant.numeric.duration.datastar"
    },
    "numbers": {
      "match": "(?<![\\w$.])(?:0[xX][0-9a-fA-F](?:_?[0-9a-fA-F])*n?|0[bB][01](?:_?[01])*n?|0[oO][0-7](?:_?[0-7])*n?|(?:\\d(?:_?\\d)*(?:\\.(?:\\d(?:_?\\d)*)?)?|\\.\\d(?:_?\\d)*)(?:[eE][+-]?\\d(?:_?\\d)*)?n?)(?![\\w$])",
      "name": "constant.numeric.datastar"
    },
    "arrow": {
      "match": "=>",
      "name": "storage.type.function.arrow.datastar"
    },
    "strings": {
      "patterns": [
        {
          "begin": "'",
          "end": "'",
          "name": "string.quoted.single.datastar",
          "patterns": [
            {
              "match": "\\\\.",
              "name": "constant.character.escape.datastar"
            }
          ]
        },
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.datastar",
          "patterns": [
            {
              "match": "\\\\.",
              "name": "constant.character.escape.datastar"
            }
          ]
        },
        {
          "begin": "`",
          "end": "`",
          "name": "string.template.datastar",
          "patterns": [
            {
              "begin": "\\$\\{",
              "end": "\\}",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.definition.template-expression.begin.datastar"
                }
              },
              "endCaptures": {
                "0": {
                  "name": "punctuation.definition.template-expression.end.datastar"
                }
              },
              "name": "meta.template.expression.datastar",
              "patterns": [
                {
                  "include": "#expression"
                }
              ]
            },
            {
              "match": "\\\\.",
              "name": "constant.character.escape.datastar"
            }
          ]
        }
      ]
    },
    "regex": {
      "comment": "A slash opens a regex where a value cannot stand before it: at the start, or after an operator, a bracket, a comma or a keyword. After a value it divides.",
      "match": "(?:\\G|^|(?<=[(,=:!&|?{};\\[+\\-*%<>~^]|\\breturn|\\btypeof|\\bin|\\bof))(\\s*)(/(?![/*])(?:\\\\.|\\[(?:\\\\.|[^\\]\\\\])*\\]|[^/\\\\\\[\\n])+/[dgimsuy]*)",
      "captures": {
        "2": {
          "name": "string.regexp.datastar"
        }
      }
    },
    "operators": {
      "patterns": [
        {
          "match": "===|!==|==|!=|<=|>=",
          "name": "keyword.operator.comparison.datastar"
        },
        {
          "match": "&&=|\\|\\|=|\\?\\?=|&&|\\|\\||\\?\\?|\\?\\.",
          "name": "keyword.operator.comparison.datastar"
        },
        {
          "match": "\\+\\+|--",
          "name": "keyword.operator.increment.datastar"
        },
        {
          "match": ">>>=|<<=|>>=|\\*\\*=|&=|\\|=|\\^=|\\+=|-=|\\*=|/=|%=|(?<![=!<>])=(?![=>])",
          "name": "keyword.operator.assignment.datastar"
        },
        {
          "match": ">>>|<<|>>|[~^|&]",
          "name": "keyword.operator.bitwise.datastar"
        },
        {
          "match": "\\*\\*|[-+*/%]|<|>|!|\\?|:",
          "name": "keyword.operator.arithmetic.datastar"
        }
      ]
    },
    "punctuation": {
      "match": "[{}()\\[\\],;]",
      "name": "punctuation.datastar"
    },
    "identifier": {
      "match": "\\b[A-Za-z_$][A-Za-z0-9_$]*\\b",
      "name": "variable.other.readwrite.datastar"
    },
    "comments": {
      "comment": "A comment in an expression. A line comment ends where the line does, or at a quote, which may close the attribute or the Kotlin string it is written in.",
      "patterns": [
        {
          "match": "/\\*.*?\\*/",
          "name": "comment.block.datastar"
        },
        {
          "begin": "/\\*",
          "end": "\\*/",
          "name": "comment.block.datastar"
        },
        {
          "match": "//.*?(?=[\"']|$)",
          "name": "comment.line.double-slash.datastar"
        }
      ]
    },
    "entity-strings": {
      "comment": "A string in HTML's spellings of a quote, as an attribute in double quotes holds a double quote.",
      "patterns": [
        {
          "begin": "&quot;|&#34;",
          "end": "&quot;|&#34;",
          "name": "string.quoted.double.datastar",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.datastar"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.datastar"
            }
          }
        },
        {
          "begin": "&#39;|&apos;",
          "end": "&#39;|&apos;",
          "name": "string.quoted.single.datastar",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.datastar"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.datastar"
            }
          }
        }
      ]
    },
    "keywords": {
      "comment": "Each keyword with the scope TypeScript's grammar gives it. grammar.test.ts holds these and the constants to the analysis's list.",
      "patterns": [
        {
          "match": "(?<![.$])\\b(if|else|switch|case)\\b",
          "name": "keyword.control.conditional.datastar"
        },
        {
          "match": "(?<![.$])\\b(return|await|yield|break|continue|throw)\\b",
          "name": "keyword.control.flow.datastar"
        },
        {
          "match": "(?<![.$])\\b(for|while|do)\\b",
          "name": "keyword.control.loop.datastar"
        },
        {
          "match": "(?<![.$])\\b(try|catch|finally)\\b",
          "name": "keyword.control.trycatch.datastar"
        },
        {
          "match": "(?<![.$])\\b(new)\\b",
          "name": "keyword.operator.new.datastar"
        },
        {
          "match": "(?<![.$])\\b(typeof|void|delete|instanceof|in|of)\\b",
          "name": "keyword.operator.expression.$1.datastar"
        },
        {
          "match": "(?<![.$])\\b(this)\\b",
          "name": "variable.language.this.datastar"
        },
        {
          "match": "(?<![.$])\\b(let|const|var)\\b",
          "name": "storage.type.datastar"
        },
        {
          "match": "(?<![.$])\\b(function)\\b",
          "name": "storage.type.function.datastar"
        },
        {
          "match": "(?<![.$])\\b(class)\\b",
          "name": "storage.type.class.datastar"
        },
        {
          "match": "(?<![.$])\\b(async)\\b",
          "name": "storage.modifier.async.datastar"
        }
      ]
    },
    "spread": {
      "match": "\\.\\.\\.",
      "name": "keyword.operator.spread.datastar"
    },
    "function-call": {
      "match": "\\b([A-Za-z_$][A-Za-z0-9_$]*)(?=\\s*\\()",
      "name": "entity.name.function.datastar"
    }
  }
}
