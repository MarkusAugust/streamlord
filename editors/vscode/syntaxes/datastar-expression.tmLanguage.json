{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Datastar expression",
  "scopeName": "source.datastar",
  "patterns": [
    {
      "include": "#expression"
    }
  ],
  "repository": {
    "expression": {
      "patterns": [
        {
          "include": "#strings"
        },
        {
          "include": "#regex"
        },
        {
          "include": "#signal"
        },
        {
          "include": "#action"
        },
        {
          "include": "#action-other"
        },
        {
          "include": "#scope-vars"
        },
        {
          "include": "#globals"
        },
        {
          "include": "#constants"
        },
        {
          "include": "#control"
        },
        {
          "include": "#option-keys"
        },
        {
          "include": "#object-key"
        },
        {
          "include": "#method-call"
        },
        {
          "include": "#property"
        },
        {
          "include": "#duration"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#arrow"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#punctuation"
        },
        {
          "include": "#identifier"
        }
      ]
    },
    "signal": {
      "match": "(\\$)([A-Za-z_][A-Za-z0-9_]*)((?:\\.[A-Za-z_][A-Za-z0-9_]*)*)",
      "captures": {
        "1": {
          "name": "punctuation.definition.signal.datastar"
        },
        "2": {
          "name": "variable.other.constant.signal.datastar"
        },
        "3": {
          "name": "variable.other.property.signal-path.datastar"
        }
      }
    },
    "action": {
      "match": "(@)(get|post|put|patch|delete|query)(?=\\s*\\()",
      "captures": {
        "1": {
          "name": "punctuation.definition.action.datastar"
        },
        "2": {
          "name": "entity.name.function.action.backend.datastar"
        }
      }
    },
    "action-other": {
      "match": "(@)([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
      "captures": {
        "1": {
          "name": "punctuation.definition.action.datastar"
        },
        "2": {
          "name": "entity.name.function.action.datastar"
        }
      }
    },
    "scope-vars": {
      "match": "\\b(el|evt|patch)\\b",
      "name": "variable.language.scope.datastar"
    },
    "globals": {
      "match": "\\b(window|document|console|Math|JSON|Date|Intl|navigator|location|history|localStorage|sessionStorage|fetch|setTimeout|setInterval|clearTimeout|clearInterval|Promise|Array|Object|String|Number|Boolean)\\b",
      "name": "support.class.global.datastar"
    },
    "constants": {
      "match": "\\b(true|false|null|undefined|NaN|Infinity)\\b",
      "name": "constant.language.datastar"
    },
    "control": {
      "match": "\\b(if|else|return|await|async|new|typeof|instanceof|in|of|for|while|do|switch|case|break|continue|throw|try|catch|finally|void|delete|function|let|const|var|this|yield|class)\\b",
      "name": "keyword.control.datastar"
    },
    "option-keys": {
      "comment": "Keys of the fetch-action options object and signal filters, when used as object keys.",
      "match": "\\b(contentType|filterSignals|selector|headers|openWhenHidden|payload|requestCancellation|responseOverrides|retry|retryInterval|retryScaler|retryMaxWait|retryMaxCount|include|exclude|mode|namespace|useViewTransition|onlyIfMissing)\\b(?=\\s*:)",
      "name": "support.type.property-name.option.datastar"
    },
    "object-key": {
      "match": "\\b([A-Za-z_$][A-Za-z0-9_$]*)\\b(?=\\s*:(?!:))",
      "name": "variable.other.property.key.datastar"
    },
    "method-call": {
      "match": "(\\.)([A-Za-z_$][A-Za-z0-9_$]*)(?=\\s*\\()",
      "captures": {
        "1": {
          "name": "punctuation.accessor.datastar"
        },
        "2": {
          "name": "entity.name.function.method.datastar"
        }
      }
    },
    "property": {
      "match": "(\\.)([A-Za-z_$][A-Za-z0-9_$]*)",
      "captures": {
        "1": {
          "name": "punctuation.accessor.datastar"
        },
        "2": {
          "name": "variable.other.property.datastar"
        }
      }
    },
    "duration": {
      "match": "\\b\\d+(?:ms|s)\\b",
      "name": "constant.numeric.duration.datastar"
    },
    "numbers": {
      "match": "\\b(?:0[xX][0-9a-fA-F]+|\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?)\\b",
      "name": "constant.numeric.datastar"
    },
    "arrow": {
      "match": "=>",
      "name": "storage.type.function.arrow.datastar"
    },
    "strings": {
      "patterns": [
        {
          "begin": "'",
          "end": "'",
          "name": "string.quoted.single.datastar",
          "patterns": [
            {
              "match": "\\\\.",
              "name": "constant.character.escape.datastar"
            },
            {
              "include": "#url"
            }
          ]
        },
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.datastar",
          "patterns": [
            {
              "match": "\\\\.",
              "name": "constant.character.escape.datastar"
            },
            {
              "include": "#url"
            }
          ]
        },
        {
          "begin": "`",
          "end": "`",
          "name": "string.template.datastar",
          "patterns": [
            {
              "begin": "\\$\\{",
              "end": "\\}",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.definition.template-expression.begin.datastar"
                }
              },
              "endCaptures": {
                "0": {
                  "name": "punctuation.definition.template-expression.end.datastar"
                }
              },
              "name": "meta.template.expression.datastar",
              "patterns": [
                {
                  "include": "#expression"
                }
              ]
            },
            {
              "match": "\\\\.",
              "name": "constant.character.escape.datastar"
            }
          ]
        }
      ]
    },
    "url": {
      "match": "(?<=^|['\"])(/[^'\"\\s]*|https?://[^'\"\\s]*)(?=['\"]|$)",
      "name": "string.other.link.url.datastar markup.underline.link.datastar"
    },
    "regex": {
      "match": "(?<=[(,:=\\s{\\[])/(?![/*])(?:\\\\.|\\[[^\\]]*\\]|[^/\\\\\\n])+/[gimsuy]*",
      "name": "string.regexp.datastar"
    },
    "operators": {
      "patterns": [
        {
          "match": "===|!==|==|!=|<=|>=|&&|\\|\\||\\?\\?|\\?\\.",
          "name": "keyword.operator.comparison.datastar"
        },
        {
          "match": "\\+\\+|--",
          "name": "keyword.operator.increment.datastar"
        },
        {
          "match": "(?<![=!<>])=(?!=)|\\+=|-=|\\*=|/=",
          "name": "keyword.operator.assignment.datastar"
        },
        {
          "match": "[-+*/%]|<|>|!|\\?|:",
          "name": "keyword.operator.arithmetic.datastar"
        }
      ]
    },
    "punctuation": {
      "match": "[{}()\\[\\],;]",
      "name": "punctuation.datastar"
    },
    "identifier": {
      "match": "\\b[A-Za-z_$][A-Za-z0-9_$]*\\b",
      "name": "variable.other.readwrite.datastar"
    }
  }
}
