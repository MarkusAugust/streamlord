{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "comment": "Generated by scripts/htmlGrammar.mjs (npm run generate) from catalog/template-syntax.json, the analysis's list. A template engine's constructs in a Datastar attribute's value in an HTML file, which Thymeleaf, Pebble and the other engines VS Code reads as HTML write before the browser reads the value: the analysis leaves them out, and they get no Datastar scope. A ${ inside a JavaScript template is JavaScript's own. The engines with a language of their own have their placeholders from their own grammar.",
  "scopeName": "streamlord.placeholders.html.injection",
  "injectionSelector": "L:text.html.derivative meta.value.datastar -string.template.datastar -meta.template.placeholder.streamlord, L:text.html.basic meta.value.datastar -string.template.datastar -meta.template.placeholder.streamlord",
  "patterns": [
    {
      "begin": "\\{\\{\\{",
      "end": "\\}\\}\\}",
      "name": "meta.template.placeholder.streamlord"
    },
    {
      "begin": "\\{\\{",
      "end": "\\}\\}",
      "name": "meta.template.placeholder.streamlord"
    },
    {
      "begin": "\\{%",
      "end": "%\\}",
      "name": "meta.template.placeholder.streamlord"
    },
    {
      "begin": "<%",
      "end": "%>",
      "name": "meta.template.placeholder.streamlord"
    },
    {
      "begin": "<\\?",
      "end": "\\?>",
      "name": "meta.template.placeholder.streamlord"
    },
    {
      "begin": "\\[#",
      "end": "\\]",
      "name": "meta.template.placeholder.streamlord"
    },
    {
      "begin": "\\[=",
      "end": "\\]",
      "name": "meta.template.placeholder.streamlord"
    },
    {
      "begin": "</#",
      "end": ">",
      "name": "meta.template.placeholder.streamlord"
    },
    {
      "begin": "<#",
      "end": ">",
      "name": "meta.template.placeholder.streamlord"
    },
    {
      "begin": "</@",
      "end": ">",
      "name": "meta.template.placeholder.streamlord"
    },
    {
      "begin": "<@",
      "end": ">",
      "name": "meta.template.placeholder.streamlord"
    },
    {
      "begin": "\\$!\\{|\\$\\{|!\\{|\\*\\{|#\\{|@\\{",
      "end": "\\}",
      "name": "meta.template.placeholder.streamlord",
      "patterns": [
        {
          "include": "#braces"
        }
      ]
    },
    {
      "begin": "(?:^|(?<=[\\s>]))(?:@(?:if|elseif|else|endif|for|endfor|template|import|param|raw|endraw)|#(?:if|elseif|else|end|foreach|set|macro|parse|include))\\b\\s*\\(",
      "end": "\\)",
      "name": "meta.template.placeholder.streamlord",
      "patterns": [
        {
          "include": "#parens"
        }
      ]
    },
    {
      "match": "(?:^|(?<=[\\s>]))(?:@(?:if|elseif|else|endif|for|endfor|template|import|param|raw|endraw)|#(?:if|elseif|else|end|foreach|set|macro|parse|include))\\b",
      "name": "meta.template.placeholder.streamlord"
    }
  ],
  "repository": {
    "braces": {
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        {
          "include": "#braces"
        }
      ]
    },
    "parens": {
      "begin": "\\(",
      "end": "\\)",
      "patterns": [
        {
          "include": "#parens"
        }
      ]
    }
  }
}
