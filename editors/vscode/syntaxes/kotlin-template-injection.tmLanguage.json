{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "scopeName": "streamlord.kotlin.template.injection",
  "comment": "Kotlin's templates in an ordinary literal that streamlord.kotlin.injection reads, which one dollar opens: what a template inserts is Kotlin's, never a signal. An escaped dollar, \\$ or ${'$'}, opens none. A $$ literal has streamlord.kotlin.template2.injection.",
  "injectionSelector": "L:meta.kotlin-template.one.streamlord -meta.template.expression.kotlin",
  "patterns": [
    {
      "include": "#one"
    }
  ],
  "repository": {
    "one": {
      "patterns": [
        {
          "match": "(?<!\\\\)(\\$)([A-Za-z_][A-Za-z0-9_]*)",
          "name": "meta.template.expression.kotlin",
          "captures": {
            "1": {
              "name": "punctuation.definition.template-expression.begin.kotlin"
            },
            "2": {
              "name": "variable.other.readwrite.kotlin"
            }
          }
        },
        {
          "begin": "(?<!\\\\)\\$\\{(?!'\\$'\\})",
          "end": "\\}",
          "name": "meta.template.expression.kotlin",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.template-expression.begin.kotlin"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.template-expression.end.kotlin"
            }
          },
          "patterns": [
            {
              "include": "#braces"
            },
            {
              "include": "source.kotlin"
            }
          ]
        }
      ]
    },
    "braces": {
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        {
          "include": "#braces"
        },
        {
          "include": "source.kotlin"
        }
      ]
    }
  }
}
