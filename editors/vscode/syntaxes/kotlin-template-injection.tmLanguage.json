{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "comment": "Generated by scripts/kotlinGrammar.mjs (npm run generate). Kotlin's templates in a string streamlord.kotlin.injection reads that 1 dollar opens a template in: what a template inserts is Kotlin's, never a signal.",
  "scopeName": "streamlord.kotlin.template.injection",
  "injectionSelector": "L:meta.kotlin-template.one.streamlord -meta.template.expression.kotlin",
  "patterns": [
    {
      "match": "(?<!\\\\)(\\$)([A-Za-z_][A-Za-z0-9_]*)",
      "name": "meta.template.expression.kotlin",
      "captures": {
        "1": {
          "name": "punctuation.definition.template-expression.begin.kotlin"
        },
        "2": {
          "name": "variable.other.readwrite.kotlin"
        }
      }
    },
    {
      "begin": "(?<!\\\\)\\$\\{(?!'\\$'\\})",
      "end": "\\}",
      "name": "meta.template.expression.kotlin",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.template-expression.begin.kotlin"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.template-expression.end.kotlin"
        }
      },
      "patterns": [
        {
          "include": "#braces"
        },
        {
          "include": "source.kotlin"
        }
      ]
    }
  ],
  "repository": {
    "braces": {
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        {
          "include": "#braces"
        },
        {
          "include": "source.kotlin"
        }
      ]
    }
  }
}
