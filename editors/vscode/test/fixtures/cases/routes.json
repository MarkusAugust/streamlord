{
  "$comment": "Routes found in Kotlin source, each as framework, method, path and the query parameters (?) and headers (H) its handler reads, a trailing ? when optional. Read by routes.test.ts and RoutesTest.kt in streamlord-analysis.",
  "cases": [
    {"name":"a verb called on a receiver is not a route","source":["fun Application.module() {","    routing {","        get(\"/top\") { }","        val v = map.get(\"key\")","        val h = call.request.headers.get(\"X-Foo\")","        client.post(\"https://example.com/hook\")","        cache.delete(\"user\")","        client","            .put(\"/chained\") { }","        val bare = get(\"key\")","    }","}"],"expected":["ktor GET /top"]},
    {"name":"ktor routes keep their shapes","source":["fun Route.api() {","    get(\"/x\") { }","    get(\"relative\") { }","    get(\"/no-lambda\")","    authenticate(\"jwt\") { post(\"/secure\") { } }","    route(\"/api\") { delete { } }","}"],"expected":["ktor GET /x","ktor GET /relative","ktor GET /no-lambda","ktor POST /secure","ktor DELETE /api"]},
    {"name":"a route with a method keeps its prefix","source":["fun Route.api() {","    route(\"/api\") {","        route(\"/v1\", HttpMethod.Get) { get(\"/deep\") { } }","        get(\"/after\") { }","    }","}"],"expected":["ktor GET /api/v1/deep","ktor GET /api/after"]},
    {"name":"finds ktor routes with nested prefixes and path-less verbs","source":["fun Route.api() {","  route(\"/api\") {","    get(\"/counter\") { }","    route(\"/coffee\") {","      get(\"/tracker\") { call.respond(\"x\") }","      route(\"/add\") { withCSRFProtection { post { } } }","    }","    delete(\"/users/{id}\") { }","  }","  get(\"/top\") { }","  post { }  // no path, no prefix: ignored","  // get(\"/comment\") { }","  val s = \"get(\\\"/string\\\")\"","}"],"expected":["ktor GET /api/counter","ktor GET /api/coffee/tracker","ktor POST /api/coffee/add","ktor DELETE /api/users/{id}","ktor GET /top"]},
    {"name":"finds spring routes with a class prefix","source":["@RestController","@RequestMapping(\"/api\")","class FeedController {","  @GetMapping(\"/feed\")","  fun feed() = 1","  @PostMapping(value = [\"/search\"], produces = [\"text/event-stream\"])","  fun search() = 2","  @RequestMapping(\"/legacy\", method = [RequestMethod.PUT])","  fun legacy() = 3","  @DeleteMapping","  fun all() = 4","}"],"expected":["spring GET /api/feed","spring POST /api/search","spring PUT /api/legacy","spring DELETE /api"]},
    {"name":"a spring class mapping is a prefix whatever stands before class","source":["@RestController","@RequestMapping(\"/api\")","internal class A {","    @GetMapping(\"/x\") fun x() {}","    @GetMapping fun root() {}","}","@RequestMapping(value = \"/d\")","public open class D { @PutMapping(value = \"/x\") fun x() {} }","@RequestMapping(\"/c\")","interface C {","    @GetMapping(\"/x\") fun x()","}"],"expected":["spring GET /api/x","spring GET /api","spring PUT /d/x","spring GET /c/x"]},
    {"name":"a spring class without a mapping has no prefix","source":["@RestController","@RequestMapping(\"/api\")","class A { @GetMapping(\"/x\") fun x() {} }","@RestController","class B { @GetMapping(\"/y\") fun y() {} }"],"expected":["spring GET /api/x","spring GET /y"]},
    {"name":"a spring method takes the prefix of the class it stands in","source":["@RequestMapping(\"/outer\")","class O {","    @RestController @RequestMapping(\"/inner\") class I { @GetMapping(\"/a\") fun a() {} }","    @GetMapping(\"/b\") fun b() {}","}","@GetMapping(\"/top\") fun top() {}"],"expected":["spring GET /inner/a","spring GET /outer/b","spring GET /top"]},
    {"name":"a mapping without its leading slash still makes a path that starts with one","source":["@RestController","@RequestMapping(\"api/hent\")","class A { @GetMapping(value = \"visning\") fun v() {} }","fun Route.api() { route(\"api\") { get(\"x\") { } } }"],"expected":["spring GET /api/hent/visning","ktor GET /api/x"]},
    {"name":"a route knows the query parameters and headers its handler reads","source":["@RestController","@RequestMapping(\"api/hent\")","class A(private val s: S) {","    @GetMapping(value = \"/visning\")","    open fun visning(","        @RequestParam partsnummer: String,","        @RequestParam instans: String,","        @RequestParam(required = false) fokus: String?,","        @RequestHeader headere: Map<String, String>,","        request: HttpServletRequest,","    ): StreamingResponseBody { val x = mapOf(1 to 2) }","","    @PostMapping(\"/b\") fun b(","        @RequestParam(\"q\") query: String, @RequestParam(name = \"p\", defaultValue = \"1\") page: Int,","        @RequestParam all: MultiValueMap<String, String>, @RequestHeader(\"X-Id\") id: String,","        @RequestHeader(value = \"X-Opt\", required = false) opt: String, @Valid @RequestParam n: List<Int>,","    ) {}","","    @GetMapping(\"/none\") fun none() {}","}","fun Route.api() {","    route(\"/k/{id}\") {","        get {","            val q = call.request.queryParameters[\"q\"] // read twice","            call.request.queryParameters[\"q\"]","            call.parameters[\"id\"]","            call.parameters.get(\"page\")","            \"queryParameters[\\\"inString\\\"]\"","        }","    }","    get(\"/l\") { }","}"],"expected":["spring GET /api/hent/visning ?partsnummer ?instans ?fokus?","spring POST /api/hent/b ?q ?p? ?n H X-Id H X-Opt?","spring GET /api/hent/none","ktor GET /k/{id} ?q? ?page?","ktor GET /l"]},
    {"name":"a spring class mapping is not a route whatever annotates the class","source":["@RequestMapping(\"/api\")","@PreAuthorize(\"hasRole('ADMIN')\")","// the admin endpoints","@Tag(name = \"admin\", description = describe(\"x\"))","class A { @GetMapping(\"/x\") fun x() {} }"],"expected":["spring GET /api/x"]}
  ]
}
