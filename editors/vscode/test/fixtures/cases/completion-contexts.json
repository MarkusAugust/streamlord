{
  "$comment": "Which attribute value a caret stands in, read as the browser reads the markup (valueAtCaret): the markup is before + after, the caret between them, prefix the attribute prefix (data- when left out). attribute is the attribute's name as written, or null when the caret stands in no quoted attribute value; value is the value before the caret with character references decoded. templates (true when left out) reads the markup as a template file does, template comments skipped. A case with nameAt also holds nameAtCaret: the attribute name the caret stands on, as its tag's name lowercased and the name typed up to the caret, or null in text, a comment, raw text or a quoted value. Read by CompletionContextsTest.kt.",
  "cases": [
    {
      "name": "a value over several lines",
      "before": "<div data-signals=\"{\n  user: {name: '',\n    age: $",
      "after": "}}\"></div>",
      "attribute": "data-signals",
      "value": "{\n  user: {name: '',\n    age: $"
    },
    {
      "name": "a value in single quotes",
      "before": "<div data-text='$cou",
      "after": "'></div>",
      "attribute": "data-text",
      "value": "$cou"
    },
    {
      "name": "character references are decoded",
      "before": "<div data-show=\"$a &amp;&amp; $",
      "after": "\"></div>",
      "attribute": "data-show",
      "value": "$a && $"
    },
    {
      "name": "the attribute the caret is in, not the first",
      "before": "<div data-text=\"$count\" data-on:click=\"@get('/x', {ret",
      "after": "})\"></div>",
      "attribute": "data-on:click",
      "value": "@get('/x', {ret"
    },
    {
      "name": "a value the markup does not close yet",
      "before": "<div data-text=\"$cou",
      "after": "",
      "attribute": "data-text",
      "value": "$cou"
    },
    {
      "name": "template syntax in the value stays in it",
      "before": "<div data-text=\"{{ x }} $c",
      "after": "\"></div>",
      "attribute": "data-text",
      "value": "{{ x }} $c"
    },
    {
      "name": "any attribute is named, Datastar's or not",
      "before": "<a href=\"/x",
      "after": "\">",
      "attribute": "href",
      "value": "/x"
    },
    {
      "name": "the aliased prefix",
      "prefix": "data-star-",
      "before": "<div data-star-text=\"$c",
      "after": "\"></div>",
      "attribute": "data-star-text",
      "value": "$c"
    },
    {
      "name": "element text is no value",
      "before": "<div data-text=\"$count\">$",
      "after": "</div>",
      "attribute": null
    },
    {
      "name": "between two attributes is no value",
      "before": "<div data-text=\"$count\" ",
      "after": "></div>",
      "attribute": null
    },
    {
      "name": "markup in a script is text of the script",
      "before": "<script>let a = '<div data-text=\"$x",
      "after": "\"></div>'\n</script>",
      "attribute": null
    },
    {
      "name": "markup in a comment is no markup",
      "before": "<!-- <div data-text=\"$c",
      "after": "\"></div> -->",
      "attribute": null
    },
    {
      "name": "a textarea's content is text, not markup",
      "before": "<textarea><i data-text=\"1 + $",
      "after": "\"></i></textarea>",
      "attribute": null
    },
    {
      "name": "a title's content is text, not markup",
      "before": "<title><i data-text=\"$",
      "after": "\"></i></title>",
      "attribute": null
    },
    {
      "name": "in an svg a textarea is svg's, and an i after it is HTML again",
      "before": "<svg><textarea><i data-text=\"$",
      "after": "\"></i></textarea></svg>",
      "attribute": "data-text",
      "value": "$"
    },
    {
      "name": "a value after a closed textarea is markup again",
      "before": "<textarea></textarea><i data-text=\"$",
      "after": "\"></i>",
      "attribute": "data-text",
      "value": "$"
    },
    {
      "name": "a value after a closed title is markup again",
      "before": "<title>x</title><i data-text=\"$",
      "after": "\"></i>",
      "attribute": "data-text",
      "value": "$"
    },
    {
      "name": "a textarea in capitals is a textarea",
      "before": "<TEXTAREA><i data-text=\"$",
      "after": "\"></i></TEXTAREA>",
      "attribute": null
    },
    {
      "name": "a noscript holds elements, as a patch is parsed with scripting off",
      "before": "<noscript><i data-text=\"$",
      "after": "\"></i></noscript>",
      "attribute": "data-text",
      "value": "$"
    },
    {
      "name": "in an svg a title is svg's, and an i after it is HTML again",
      "before": "<svg><title><i data-text=\"$",
      "after": "\"></i></title></svg>",
      "attribute": "data-text",
      "value": "$"
    },
    {
      "name": "the tag of a name over three lines",
      "before": "<input\n  type=\"search\"\n  data-bind:query\n  data-on:input__",
      "after": ">",
      "attribute": null,
      "nameAt": {"tag": "input", "typed": "data-on:input__"}
    },
    {
      "name": "no tag in a quoted value",
      "before": "<div data-text=\"$a",
      "after": "\"></div>",
      "attribute": "data-text",
      "value": "$a",
      "nameAt": null
    },
    {
      "name": "no tag in text",
      "before": "<p>x</p> data-on:click__",
      "after": "",
      "attribute": null,
      "nameAt": null
    },
    {
      "name": "no tag in a comment",
      "before": "<!-- <div data-on:click__",
      "after": " -->",
      "attribute": null,
      "nameAt": null
    },
    {
      "name": "no tag in a script's text",
      "before": "<script>if (a<b && data-on:click__",
      "after": "</script>",
      "attribute": null,
      "nameAt": null
    },
    {
      "name": "the tag after a textarea holding <b",
      "before": "<textarea><b</textarea>\n<div data-on:click__",
      "after": "></div>",
      "attribute": null,
      "nameAt": {"tag": "div", "typed": "data-on:click__"}
    },
    {
      "name": "a template comment is skipped with templates",
      "before": "{{!-- <i --}}<div data-on:click__",
      "after": "></div>",
      "attribute": null,
      "nameAt": {"tag": "div", "typed": "data-on:click__"}
    },
    {
      "name": "a template comment opens a tag without templates",
      "templates": false,
      "before": "{{!-- <i --}}<div data-on:click__",
      "after": "></div>",
      "attribute": null,
      "nameAt": {"tag": "i", "typed": "data-on:click__"}
    }
  ]
}
