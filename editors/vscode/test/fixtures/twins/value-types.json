{
  "$comment": "What a Kotlin type or string literal, as the source writes it, tells of a value joined into HTML: the fact of a declared type (null when nothing is known), whether a type is a collection of Streamlord's markup, and whether a literal's content opens with a tag. The IntelliJ plugin reads types and literals with the same functions. Read by ValueTypesTest.kt and valueTypes.test.ts.",
  "cases": [
    {"name":"a number","type":"Int","fact":"number"},
    {"name":"a number written in full that may be null","type":"kotlin.Long?","fact":"nullable"},
    {"name":"an unsigned number","type":"UInt","fact":"unsigned"},
    {"name":"an unsigned number that may be null","type":"UByte?","fact":"nullable"},
    {"name":"a boolean","type":"Boolean","fact":"boolean"},
    {"name":"a string","type":"String","fact":"string"},
    {"name":"a string that may be null","type":"String?","fact":"nullable-string"},
    {"name":"a CharSequence is a string","type":"kotlin.CharSequence","fact":"string"},
    {"name":"Streamlord's Html","type":"Html","fact":"markup"},
    {"name":"Streamlord's Html that may be null","type":"Html?","fact":"markup"},
    {"name":"Streamlord's Html written out in full","type":"io.github.markusaugust.streamlord.core.domain.Html","fact":"markup"},
    {"name":"an Html of another package","type":"com.acme.Html","fact":null},
    {"name":"Streamlord's Trusted","type":"Trusted","fact":"markup"},
    {"name":"a Trusted that may be null","type":"Trusted?","fact":null},
    {"name":"a Trusted of another package","type":"com.acme.Trusted","fact":null},
    {"name":"Streamlord's Trusted written out in full","type":"io.github.markusaugust.streamlord.core.domain.Trusted","fact":"markup"},
    {"name":"whitespace in a type is ignored","type":"kotlin . Int ?","fact":"nullable"},
    {"name":"any other type","type":"Foo","fact":null},
    {"name":"a list of Html","collection":"List<Html>","markup":true},
    {"name":"an array of Html","collection":"Array<Html>","markup":true},
    {"name":"a sequence of Trusted written out in full","collection":"kotlin.sequences.Sequence<Trusted>","markup":true},
    {"name":"a list of Html that may be null","collection":"List<Html?>","markup":false},
    {"name":"a collection of Trusted written out in full","collection":"kotlin.collections.Collection<io.github.markusaugust.streamlord.core.domain.Trusted>","markup":true},
    {"name":"a set of Html that may be null","collection":"Set< Html >?","markup":true},
    {"name":"a list of another package's Html","collection":"List<com.acme.Html>","markup":false},
    {"name":"a list of strings","collection":"List<String>","markup":false},
    {"name":"a map is not a collection joinToString takes","collection":"Map<String,Html>","markup":false},
    {"name":"a tag","content":"<p>x</p>","tag":true},
    {"name":"a tag in capitals","content":"<P>","tag":true},
