    {"name":"a comment after whitespace","content":"\n  <!-- x -->","tag":true},
    {"name":"a doctype","content":"<!DOCTYPE html>","tag":true},
    {"name":"a tag named by a template","content":"<$tag class=\"c\">","tag":true},
    {"name":"a tag named by a braced template","content":"<${t.name}>","tag":true},
    {"name":"a template that runs on past the tag name","content":"<$tag","tag":false},
    {"name":"a search pattern after the template is no tag","content":"<$tag\\b","tag":false},
    {"name":"a %s of interpolate's format as the tag name","content":"<__kt__ id=\"x\">","tag":true},
    {"name":"text before the tag","content":"x <p>","tag":false},
    {"name":"a less-than sign that opens no tag","content":"<3","tag":false},
    {"name":"a margin without trimMargin","content":"  |<p>","tag":false},
    {"name":"a margin trimMargin removes","content":"  |<p>","trimMargin":true,"tag":true},
    {"name":"a margin on the line after the opening quotes","content":"\n    |<p>","trimMargin":true,"tag":true},
