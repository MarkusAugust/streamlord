    {"name":"a literal followed by trimIndent","source":"dataOnClick(\"\"\"$count++\"\"\".trimIndent())","issues":[{"code":"kotlin-interpolation","start":15,"end":21,"fixes":["dataOnClick(increment(\"count\"))","dataOnClick($$\"\"\"$count++\"\"\".trimIndent())","dataOnClick(\"\"\"${'$'}count++\"\"\".trimIndent())"]}]},
