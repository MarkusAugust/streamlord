    {"name":"a literal dollar before a template","source":"dataOnClick(\"$a + $$b\")","issues":[{"code":"kotlin-interpolation","start":13,"end":15,"fixes":["dataOnClick($$$\"$a + $$$$b\")","dataOnClick(\"${'$'}a + $$b\")","dataOnClick(\"\\$a + $$b\")"]},{"code":"kotlin-interpolation","start":19,"end":21,"fixes":["dataOnClick($$$\"$$$a + $$b\")","dataOnClick(\"$a + $${'$'}b\")","dataOnClick(\"$a + $\\$b\")"]}]},
