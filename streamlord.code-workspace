{
  "folders": [
    {
      "name": "streamlord",
      "path": "."
    }
  ],
  "settings": {
    "files.exclude": {
      "**/.gradle": true,
      "**/build": true,
      "**/node_modules": true
    },
    "search.exclude": {
      "**/build": true,
      "**/node_modules": true,
      "**/dist": true
    },
    "[kotlin]": {
      "editor.wordWrap": "off"
    },
    "[html]": {
      "editor.wordWrap": "off"
    },
    "editor.tokenColorCustomizations": {
      "textMateRules": [
        {
          "name": "Streamlord: signal",
          "scope": [
            "variable.other.constant.signal.datastar",
            "punctuation.definition.signal.datastar"
          ],
          "settings": {
            "foreground": "#4FC1FF",
            "fontStyle": "bold"
          }
        },
        {
          "name": "Streamlord: signal path",
          "scope": [
            "variable.other.property.signal-path.datastar"
          ],
          "settings": {
            "foreground": "#9CDCFE"
          }
        },
        {
          "name": "Streamlord: backend action",
          "scope": [
            "entity.name.function.action.backend.datastar",
            "punctuation.definition.action.datastar"
          ],
          "settings": {
            "foreground": "#C586C0",
            "fontStyle": "bold"
          }
        },
        {
          "name": "Streamlord: action",
          "scope": [
            "entity.name.function.action.datastar"
          ],
          "settings": {
            "foreground": "#C586C0"
          }
        },
        {
          "name": "Streamlord: el / evt / patch",
          "scope": [
            "variable.language.scope.datastar"
          ],
          "settings": {
            "foreground": "#569CD6",
            "fontStyle": "italic"
          }
        },
        {
          "name": "Streamlord: option keys",
          "scope": [
            "support.type.property-name.option.datastar"
          ],
          "settings": {
            "foreground": "#9CDCFE",
            "fontStyle": "bold"
          }
        },
        {
          "name": "Streamlord: object keys",
          "scope": [
            "variable.other.property.key.datastar"
          ],
          "settings": {
            "foreground": "#9CDCFE"
          }
        },
        {
          "name": "Streamlord: identifiers",
          "scope": [
            "variable.other.readwrite.datastar"
          ],
          "settings": {
            "foreground": "#9CDCFE"
          }
        },
        {
          "name": "Streamlord: duration",
          "scope": [
            "constant.numeric.duration.datastar"
          ],
          "settings": {
            "foreground": "#B5CEA8"
          }
        },
        {
          "name": "Streamlord: kotlin dollar escape",
          "scope": [
            "constant.character.escape.dollar.kotlin"
          ],
          "settings": {
            "foreground": "#D7BA7D"
          }
        },
        {
          "name": "Streamlord: attribute prefix",
          "scope": [
            "entity.other.attribute-name.datastar.prefix"
          ],
          "settings": {
            "foreground": "#808080"
          }
        },
        {
          "name": "Streamlord: attribute plugin",
          "scope": [
            "entity.other.attribute-name.datastar.plugin"
          ],
          "settings": {
            "foreground": "#C586C0",
            "fontStyle": "bold"
          }
        },
        {
          "name": "Streamlord: attribute key",
          "scope": [
            "entity.other.attribute-name.datastar.key"
          ],
          "settings": {
            "foreground": "#4EC9B0"
          }
        },
        {
          "name": "Streamlord: modifier",
          "scope": [
            "keyword.other.modifier.datastar"
          ],
          "settings": {
            "foreground": "#569CD6"
          }
        },
        {
          "name": "Streamlord: modifier sigils",
          "scope": [
            "punctuation.definition.modifier.datastar",
            "punctuation.separator.key.datastar"
          ],
          "settings": {
            "foreground": "#808080"
          }
        },
        {
          "name": "Streamlord: modifier argument",
          "scope": [
            "constant.other.modifier-arg.datastar"
          ],
          "settings": {
            "foreground": "#4EC9B0"
          }
        }
      ],
      "[*Light*]": {
        "textMateRules": [
          {
            "name": "Streamlord: signal",
            "scope": [
              "variable.other.constant.signal.datastar",
              "punctuation.definition.signal.datastar"
            ],
            "settings": {
              "foreground": "#0070C1",
              "fontStyle": "bold"
            }
          },
          {
            "name": "Streamlord: signal path",
            "scope": [
              "variable.other.property.signal-path.datastar"
            ],
            "settings": {
              "foreground": "#001080"
            }
          },
          {
            "name": "Streamlord: backend action",
            "scope": [
              "entity.name.function.action.backend.datastar",
              "punctuation.definition.action.datastar"
            ],
            "settings": {
              "foreground": "#AF00DB",
              "fontStyle": "bold"
            }
          },
          {
            "name": "Streamlord: action",
            "scope": [
              "entity.name.function.action.datastar"
            ],
            "settings": {
              "foreground": "#AF00DB"
            }
          },
          {
            "name": "Streamlord: el / evt / patch",
            "scope": [
              "variable.language.scope.datastar"
            ],
            "settings": {
              "foreground": "#0000FF",
              "fontStyle": "italic"
            }
          },
          {
            "name": "Streamlord: option keys",
            "scope": [
              "support.type.property-name.option.datastar"
            ],
            "settings": {
              "foreground": "#001080",
              "fontStyle": "bold"
            }
          },
          {
            "name": "Streamlord: object keys",
            "scope": [
              "variable.other.property.key.datastar"
            ],
            "settings": {
              "foreground": "#001080"
            }
          },
          {
            "name": "Streamlord: identifiers",
            "scope": [
              "variable.other.readwrite.datastar"
            ],
            "settings": {
              "foreground": "#001080"
            }
          },
          {
            "name": "Streamlord: duration",
            "scope": [
              "constant.numeric.duration.datastar"
            ],
            "settings": {
              "foreground": "#098658"
            }
          },
          {
            "name": "Streamlord: kotlin dollar escape",
            "scope": [
              "constant.character.escape.dollar.kotlin"
            ],
            "settings": {
              "foreground": "#EE0000"
            }
          },
          {
            "name": "Streamlord: attribute prefix",
            "scope": [
              "entity.other.attribute-name.datastar.prefix"
            ],
            "settings": {
              "foreground": "#8E8E8E"
            }
          },
          {
            "name": "Streamlord: attribute plugin",
            "scope": [
              "entity.other.attribute-name.datastar.plugin"
            ],
            "settings": {
              "foreground": "#AF00DB",
              "fontStyle": "bold"
            }
          },
          {
            "name": "Streamlord: attribute key",
            "scope": [
              "entity.other.attribute-name.datastar.key"
            ],
            "settings": {
              "foreground": "#267F99"
            }
          },
          {
            "name": "Streamlord: modifier",
            "scope": [
              "keyword.other.modifier.datastar"
            ],
            "settings": {
              "foreground": "#0000FF"
            }
          },
          {
            "name": "Streamlord: modifier sigils",
            "scope": [
              "punctuation.definition.modifier.datastar",
              "punctuation.separator.key.datastar"
            ],
            "settings": {
              "foreground": "#8E8E8E"
            }
          },
          {
            "name": "Streamlord: modifier argument",
            "scope": [
              "constant.other.modifier-arg.datastar"
            ],
            "settings": {
              "foreground": "#267F99"
            }
          }
        ]
      }
    }
  },
  "extensions": {
    "recommendations": [
      "jetbrains.kotlin-server"
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Run Streamlord extension",
        "type": "extensionHost",
        "request": "launch",
        "args": [
          "--extensionDevelopmentPath=${workspaceFolder}/editors/vscode"
        ],
        "outFiles": [
          "${workspaceFolder}/editors/vscode/dist/**/*.js"
        ],
        "preLaunchTask": "streamlord: build extension"
      }
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "streamlord: build extension",
        "type": "shell",
        "command": "npm run build",
        "options": {
          "cwd": "${workspaceFolder}/editors/vscode"
        },
        "problemMatcher": [],
        "presentation": {
          "reveal": "silent"
        }
      }
    ]
  }
}
